{
  "name": "nextvision-studio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check:indexability": "node scripts/check-indexability.mjs",
    "check:service-content": "node scripts/check-service-content.mjs",
    "check:measurement": "node --test scripts/check-measurement.mjs scripts/check-behavior-tracking.mjs scripts/check-cookie-preferences.mjs scripts/check-content-measurement.mjs",
    "check:motion": "node --test scripts/check-background-motion.mjs scripts/check-orbit-scroll.mjs scripts/check-orbit-counters.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check:seo-growth": "node scripts/check-seo-growth.mjs",
    "check:orbit-release": "node scripts/check-orbit-release.mjs",
    "check:orbit-packages": "node --test scripts/check-orbit-packages.mjs",
    "check:types": "astro-check --minimumFailingSeverity error",
    "check:audit": "node --test scripts/check-audit-regressions.mjs && node scripts/check-seo-integrity.mjs",
    "check:performance": "node scripts/check-performance.mjs"
  },
  "dependencies": {
    "astro": "^7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  }
}
