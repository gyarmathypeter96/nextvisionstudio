---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import GoogleTag from "../components/GoogleTag.astro";
import CookieConsent from "../components/CookieConsent.astro";
import LeadAttribution from "../components/LeadAttribution.astro";
import {
  CONTACT_EMAIL,
  CONTACT_PHONE_E164,
  SITE_NAME,
  SITE_URL,
} from "../config/site";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  preloadImage?: string;
  noindex?: boolean;
  minimal?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage,
  preloadImage,
  noindex = false,
  minimal = false,
} = Astro.props;
const canonicalUrl = canonical || `${SITE_URL}${Astro.url.pathname}`;
const socialImage = ogImage
  ? new URL(ogImage, SITE_URL).toString()
  : `${SITE_URL}/images/showreel/showreel-2025.webp`;

const websiteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: SITE_NAME,
      inLanguage: "en-IE",
      publisher: { "@id": `${SITE_URL}/#business` },
    },
    {
      "@type": ["LocalBusiness", "ProfessionalService"],
      "@id": `${SITE_URL}/#business`,
      name: SITE_NAME,
      url: `${SITE_URL}/`,
      image: socialImage,
      logo: `${SITE_URL}/images/brand/nextvision-studio-logo.webp`,
      email: CONTACT_EMAIL,
      telephone: CONTACT_PHONE_E164,
      address: {
        "@type": "PostalAddress",
        addressLocality: "Dublin",
        addressCountry: "IE",
      },
      areaServed: {
        "@type": "City",
        name: "Dublin",
      },
      knowsAbout: [
        "Short-form video production Dublin",
        "Business Reels production Dublin",
        "Videography Dublin",
        "Video production Dublin",
        "Photography Dublin",
        "Social media content creation",
        "Meta Ads",
        "Google Ads",
        "Website design Dublin",
        "AI lead conversion",
        "Business automation",
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={
        noindex
          ? "noindex, nofollow"
          : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
      }
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_IE" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={`${SITE_NAME} — Dublin creative studio`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <link rel="canonical" href={canonicalUrl} />
    {
      preloadImage && (
        <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
      )
    }
    <link rel="icon" href="/favicon-32.png?v=2" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png?v=2" type="image/png" sizes="192x192" />
    <link rel="shortcut icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#111111" />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <GoogleTag />
    <!-- Optional analytics loaders. No third-party request is made before consent. -->
    <script is:inline>
      (() => {
        const clarityProjectId = "ylqu4w3rot";
        const metaPixelId = "657703057386811";

        window.nvsLoadClarity = window.nvsLoadClarity || function () {
          if (document.querySelector("script[data-nvs-clarity]")) return;

          window.clarity = window.clarity || function () {
            (window.clarity.q = window.clarity.q || []).push(arguments);
          };

          const script = document.createElement("script");
          script.async = true;
          script.src = `https://www.clarity.ms/tag/${clarityProjectId}`;
          script.dataset.nvsClarity = "true";
          document.head.appendChild(script);
        };

        window.nvsLoadMetaPixel = window.nvsLoadMetaPixel || function () {
          if (document.querySelector("script[data-nvs-meta-pixel]")) return;

          const fbq = window.fbq = window.fbq || function () {
            if (fbq.callMethod) {
              fbq.callMethod.apply(fbq, arguments);
            } else {
              fbq.queue.push(arguments);
            }
          };

          if (!window._fbq) window._fbq = fbq;
          fbq.push = fbq;
          fbq.loaded = true;
          fbq.version = "2.0";
          fbq.queue = fbq.queue || [];

          const script = document.createElement("script");
          script.async = true;
          script.src = "https://connect.facebook.net/en_US/fbevents.js";
          script.dataset.nvsMetaPixel = "true";
          document.head.appendChild(script);

          fbq("init", metaPixelId);
          fbq("track", "PageView");
        };

        let storedConsent = null;
        try {
          storedConsent = localStorage.getItem("nvs-cookie-consent");
        } catch (_) {}

        if (storedConsent !== "granted") return;

        const loadOptionalAnalytics = () => {
          window.nvsLoadClarity();
          window.nvsLoadMetaPixel();
        };

        if ("requestIdleCallback" in window) {
          window.requestIdleCallback(loadOptionalAnalytics, { timeout: 1800 });
        } else {
          window.setTimeout(loadOptionalAnalytics, 900);
        }
      })();
    </script>
  </head>

  <body>
    {
      minimal ? (
        <div class="minimal-site-logo" aria-label="NextVision Studio">
          <img
            src="/images/brand/nextvision-studio-logo.webp"
            width="500"
            height="500"
            alt="NextVision Studio"
            decoding="async"
          />
        </div>
      ) : (
        <SiteHeader />
      )
    }
    <slot />
    {!minimal && <SiteFooter />}
    <WhatsAppButton />
    <CookieConsent />
    <LeadAttribution />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    background: #111111;
    color-scheme: dark;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background: #111111;
    color: #ffffff;
    font-family: Inter, Arial, sans-serif;
  }

  img,
  video,
  iframe {
    max-width: 100%;
  }

  a {
    color: inherit;
  }

  .minimal-site-logo {
    position: absolute;
    top: max(18px, env(safe-area-inset-top));
    left: max(20px, env(safe-area-inset-left));
    z-index: 20;
    width: 58px;
    height: 58px;
  }

  .minimal-site-logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
