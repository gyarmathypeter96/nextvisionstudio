---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Website Quote Request Received | NextVision Studio"
  description="Your website quote request has been received by NextVision Studio."
  canonical="https://www.nextvisionstudio.com/website-design-quote/thanks/"
  noindex={true}
  minimal={true}
>
  <main class="quote-thanks">
    <section aria-labelledby="quote-thanks-title">
      <p>Message received</p>
      <h1 id="quote-thanks-title">Thank you for your enquiry.</h1>
      <p>We will reply within one working day.</p>
    </section>
  </main>
</BaseLayout>

<style>
  .quote-thanks {
    display: grid;
    min-height: 100svh;
    place-items: center;
    padding: 120px 24px;
    background: radial-gradient(circle at 50% 42%, rgba(155, 210, 255, 0.13), transparent 31%), #111111;
    color: #ffffff;
    text-align: center;
  }

  .quote-thanks section { width: min(100%, 760px); }

  .quote-thanks section > p:first-child {
    margin: 0 0 20px;
    color: #cfeaff;
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .quote-thanks h1 {
    margin: 0;
    font-size: clamp(50px, 8vw, 88px);
    font-weight: 950;
    letter-spacing: -0.07em;
    line-height: 0.94;
  }

  .quote-thanks section > p:last-child {
    margin: 25px 0 0;
    color: rgba(255, 255, 255, 0.65);
    font-size: 18px;
    line-height: 1.6;
  }
</style>
