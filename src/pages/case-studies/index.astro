---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { caseStudies } from "../../data/caseStudies";

const projects = caseStudies;
const canonical = "https://www.nextvisionstudio.com/case-studies/";
const indexSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: "Video Production Case Studies Dublin",
      isPartOf: { "@id": "https://www.nextvisionstudio.com/#website" },
      mainEntity: {
        "@type": "ItemList",
        itemListElement: projects.map((project, index) => ({
          "@type": "ListItem",
          position: index + 1,
          url: `https://www.nextvisionstudio.com${project.href}`,
          name: project.title,
        })),
      },
    },

  ],
};
---

<BaseLayout
  title="Video Production Case Studies Dublin | NextVision Studio"
  description="Real video production, social media content and event videography projects by NextVision Studio in Dublin, Ireland and abroad."
  canonical="https://www.nextvisionstudio.com/case-studies/"
>
  <script type="application/ld+json" set:html={JSON.stringify(indexSchema)} />
  <main class="case-index">
    <section class="case-index__hero">
      <h1>Real projects. Clear decisions. Finished work that earns attention.</h1>
      <p>See how NextVision Studio approaches event videography, social content, product video and ongoing brand production for real clients.</p>
    </section>

    <section class="case-index__grid" aria-label="NextVision Studio project case studies">
      {projects.map((project) => (
        <a class="case-index__item" href={project.href}>
          {project.image ? <img src={project.image} alt={project.alt} width="1280" height="720" loading="lazy" decoding="async" /> : <div class="case-index__media-pending"><span>Project preview</span><strong>{project.client}</strong><small>Selected image to follow</small></div>}
          <div class="case-index__copy">
            <h2>{project.title}</h2>
            <span>{project.location}</span>
            <strong>Read project</strong>
          </div>
        </a>
      ))}
    </section>

    <section class="case-index__cta">
      <div>

        <h2>Have a brief, a goal or just the first idea?</h2>
      </div>
      <a href="/contact/#contact-form" data-cta-placement="case-studies-index">Start a project</a>
    </section>
  </main>
</BaseLayout>

<style>
  .case-index, .case-index * { box-sizing: border-box; }
  .case-index { background: #111111; color: #ffffff; }
  .case-index__hero, .case-index__grid, .case-index__cta { width: min(100% - 48px, 1180px); margin: 0 auto; }
  .case-index__hero { padding: 132px 0 48px; }
  .case-kicker { margin: 0 0 18px; color: #b9dfff; font-size: 11px; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
  .case-index h1 { max-width: 880px; margin: 0; font-size: clamp(36px, 5.2vw, 64px); line-height: 1.08; letter-spacing: -.025em; text-wrap: balance; }
  .case-index__hero > p:last-child { max-width: 620px; margin: 30px 0 0; color: rgba(255,255,255,.68); font-size: 19px; line-height: 1.65; }
  .case-index__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; padding-bottom: 110px; }
  .case-index__item { display: block; color: inherit; text-decoration: none; border-top: 1px solid rgba(185,223,255,.18); }
  .case-index__item img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; object-position: center 30%; margin-top: 24px; border-radius: 8px; transition: transform 220ms ease; }
  .case-index__media-pending { display: flex; flex-direction: column; justify-content: center; aspect-ratio: 16 / 9; margin-top: 24px; padding: 28px; border: 1px dashed rgba(185,223,255,.35); background: #171b1f; }
  .case-index__media-pending span, .case-index__media-pending small { color: #b9dfff; font-size: 12px; }
  .case-index__media-pending strong { margin: 22px 0; font-size: clamp(26px,4vw,43px); line-height: 1.05; }
  .case-index__item:hover img { transform: scale(1.015); }
  .case-index__copy { padding: 24px 0 20px; }
  .case-index__copy p { margin: 0 0 10px; color: #b9dfff; font-size: 11px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
  .case-index__copy h2 { margin: 0; font-size: clamp(24px, 3vw, 37px); line-height: 1.05; }
  .case-index__copy span { display: block; margin-top: 12px; color: rgba(255,255,255,.5); font-size: 14px; }
  .case-index__copy strong { display: inline-flex; margin-top: 23px; color: #cfeaff; font-size: 13px; }
  .case-index__cta { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 30px; padding: 80px 0 120px; border-top: 1px solid rgba(185,223,255,.13); }
  .case-index__cta h2 { max-width: 620px; margin: 0; font-size: clamp(32px, 4vw, 56px); line-height: 1.02; }
  .case-index__cta a { display: inline-flex; min-height: 48px; align-items: center; padding: 0 20px; background: #cfeaff; color: #111111; font-size: 13px; font-weight: 900; text-decoration: none; }
  @media (max-width: 700px) { .case-index__grid { grid-template-columns: 1fr; } .case-index__cta { grid-template-columns: 1fr; align-items: start; } }
  @media (max-width: 560px) { .case-index__hero, .case-index__grid, .case-index__cta { width: min(100% - 32px, 1180px); } .case-index__hero { padding: 74px 0 52px; } .case-index__grid { padding-bottom: 70px; } .case-index__cta { padding: 64px 0 84px; } }
</style>
