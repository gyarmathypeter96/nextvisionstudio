---
import VercelAnalytics from "../components/VercelAnalytics.astro";
import TagManager from "../components/TagManager.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { ANALYTICS_HOSTS } from "../config/site";

const media = "/images/christmas-2026/";
const studioPhotos = [
  ["DSC09799", "Christmas studio portrait"],
  ["DSC09803", "Portrait from the Christmas studio session"],
  ["DSC09804", "Christmas portrait with festive decorations"],
  ["DSC09805", "Portrait in the Christmas set"],
  ["DSC09806", "Christmas studio portrait"],
  ["DSC09807", "Portrait from the Christmas studio session"],
  ["DSC09809", "Christmas portrait"],
  ["DSC09812", "Festive studio portrait"],
  ["DSC09818", "Christmas studio portrait"],
  ["DSC09819", "Portrait from the Christmas studio session"],
  ["studio-overview", "The decorated Christmas studio"],
];
const examples = [
  ["holiday-treats", "A woman and a girl sharing sweets at a Christmas table"],
  ["christmas-mug", "A girl holding a red Christmas mug"],
  ["family", "A family sitting together beside a Christmas tree"],
  ["tree-lights", "Parents holding a toddler beside Christmas lights"],
];
const phone = "+353838697791";
const phoneDisplay = "+353 83 869 7791";
// Real client feedback for Dora's sessions, translated from Hungarian and
// shared with the clients' permission (confirmed by the owner, Nov 2026).
const testimonials = [
  ["Bia", "Such a lovely atmosphere. We really enjoyed it and it felt properly Christmassy."],
  ["Anna", "I went with my little one and everyone was so kind. There were plenty of toys to keep them busy, and Dora is brilliant with children."],
  ["Dave", "We came for a couples' Christmas shoot. I'm not comfortable in front of the camera, but the atmosphere and the direction helped a lot."],
  ["John", "We came for a family shoot with my partner and our two little ones. The kids loved it too, and Dora handled everything really professionally. Highly recommend."],
];
const whatsapp = "https://wa.me/353838697791";
const whatsappQuestion = whatsapp + "?text=" + encodeURIComponent("Hi! I have a question about the Christmas photoshoot.");
---
<!doctype html>
<html lang="en-IE">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Christmas Photoshoot in Balbriggan – €150 | NextVision Studio</title>
  <meta name="description" content="Book a one-hour Christmas studio photoshoot in Balbriggan. €150 for 15 edited photos, delivered within 48 hours of choosing your favourites.">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="NextVision Studio">
  <meta property="og:locale" content="en_IE">
  <meta property="og:url" content="https://www.nextvisionstudio.com/christmas-photoshoot/">
  <meta property="og:title" content="Christmas Photoshoot in Balbriggan – €150 | NextVision Studio">
  <meta property="og:description" content="Book a one-hour Christmas studio photoshoot in Balbriggan. €150 for 15 edited photos, delivered within 48 hours of choosing your favourites.">
  <meta property="og:image" content="https://www.nextvisionstudio.com/images/christmas-2026/og-christmas-photoshoot.jpg">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="A woman with a red mug on a sofa beside a lit Christmas tree in the NextVision Christmas studio">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="robots" content="noindex, follow">
  <link rel="canonical" href="https://www.nextvisionstudio.com/christmas-photoshoot/">
  <link rel="icon" href="/images/brand/nextvision-studio-logo.webp">
  <link rel="stylesheet" href="/christmas-2026.css">
  <!-- Keep owner traffic out of Vercel Analytics and GTM before either loads. -->
  <script is:inline define:vars={{ analyticsHosts: ANALYTICS_HOSTS }}>
    (() => {
      const marker = "nvs-owner-optout";
      const url = new URL(window.location.href);
      const choice = url.searchParams.get("nvs_owner_optout");
      let excluded = choice === "1";

      try {
        if (choice === "1") localStorage.setItem(marker, "1");
        if (choice === "0") localStorage.removeItem(marker);
        excluded = localStorage.getItem(marker) === "1";
      } catch (_) {}

      window.nvsOwnerExcluded = excluded;
      window.nvsTrackingExcluded = excluded || !analyticsHosts.includes(window.location.hostname);
      if (choice === "1" || choice === "0") {
        url.searchParams.delete("nvs_owner_optout");
        history.replaceState(history.state, "", url.pathname + url.search + url.hash);
      }
    })();
  </script>
  <TagManager />
  <VercelAnalytics />
</head>
<body>
  <header class="masthead">
    <div class="shell masthead-inner">
      <a class="brand" href="/" aria-label="Visit the NextVision Studio homepage"><img src="/orbit/assets/nextvision-astronaut-logo.webp" alt="" width="500" height="425"><span>NextVision Studio</span></a>
      <nav aria-label="On this page">
        <a class="nav-link" href="#portfolio">Portfolio</a>
        <a class="button nav-book" href="#booking">Book a session</a>
      </nav>
    </div>
  </header>
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-stars" aria-hidden="true"><span>✦</span><span>✧</span><span>✦</span><span>✦</span></div>
      <div class="shell hero-inner">
        <div class="hero-copy">
          <h1 id="hero-title">Christmas<br> Photoshoots</h1>
          <p class="hero-intro">A relaxed hour in our Christmas studio for family portraits and the little moments in between.</p>
          <div class="hero-actions">
            <a class="button primary" href="#booking">Choose a time <span aria-hidden="true">↗</span></a>
            <a class="button whatsapp-button" href={whatsapp} target="_blank" rel="noopener">Questions? Message us on WhatsApp</a>
          </div>
        </div>
        <video class="christmas-promo" controls playsinline preload="none" poster={media + "promo-poster.webp"} aria-label="Watch the Christmas photoshoot promo">
          <source src="/videos/christmas-2026/promo.mp4" type="video/mp4">
          <a href="/videos/christmas-2026/promo.mp4">Watch the Christmas photoshoot promo</a>
        </video>
      </div>
    </section>
    <section class="package" aria-label="Session details">
      <div class="shell package-inner">
        <div><strong>1 hour</strong><span>Private studio session</span></div>
        <div><strong>15 edited photos</strong><span>Within 48 hours of your selection</span></div>
        <div><strong>€150</strong><span>Fixed price, payable on the day</span></div>
      </div>
    </section>
    <section class="testimonials" aria-labelledby="testimonials-title">
      <div class="testimonial-stars" aria-hidden="true"><span>✦</span><span>✧</span><span>✦</span><span>✧</span><span>✦</span></div>
      <div class="shell">
      <p class="testimonial-eyebrow"><span aria-hidden="true">✦</span> Kind words <span aria-hidden="true">✦</span></p>
      <h2 id="testimonials-title">What families say</h2>
      <div class="testimonial-grid">
        {testimonials.map(([name, quote]) => (
          <figure class="testimonial">
            <blockquote><p>{quote}</p></blockquote>
            <figcaption><span class="testimonial-initial" aria-hidden="true">{name.charAt(0)}</span>{name}</figcaption>
          </figure>
        ))}
      </div>
      </div>
    </section>
    <section id="portfolio" class="portfolio shell" aria-labelledby="portfolio-title">
      <h2 id="portfolio-title">Inside our Christmas studio</h2>
      <div class="photo-grid studio-grid">
        {studioPhotos.map(([file, alt]) => (
          <a href={media + file + ".webp"} target="_blank" rel="noopener" data-lightbox>
            <img src={media + file + ".webp"} alt={alt} width="960" height="1440" loading="lazy" decoding="async">
          </a>
        ))}
      </div>
      <figure class="reference-photos">
        <figcaption>These family photos were taken in a different studio and are shown as examples.</figcaption>
        <div class="photo-grid">
          {examples.map(([file, alt]) => (
            <a href={media + file + ".webp"} target="_blank" rel="noopener" data-lightbox>
              <img src={media + file + ".webp"} alt={alt} width="730" height="1298" loading="lazy" decoding="async">
            </a>
          ))}
        </div>
      </figure>
    </section>
    <section id="booking" class="booking shell" aria-labelledby="booking-title">
      <div class="booking-copy">
        <h2 id="booking-title">Book your session</h2>
        <ul class="booking-facts">
          <li><strong>Weekday evenings</strong> 18:00–19:00 or 19:00–20:00</li>
          <li><strong>€150, paid on the day</strong> 15 edited photos within 48 hours</li>
          <li><strong>Last session</strong> Friday 18 December</li>
        </ul>
        <p class="capacity-note"><strong>Limited studio capacity</strong>For comfort and space, each session can accommodate up to 2 adults and 2 small children, or 3 adults.</p>
      </div>
      <div class="booking-panel" data-christmas-booking>
        <form id="booking-form">
          <p class="date-picker" id="date-label">Choose a date</p>
          <div class="date-chips" id="date-chips" role="radiogroup" aria-labelledby="date-label"></div>
          <select id="booking-date" class="date-select" required disabled tabindex="-1" aria-hidden="true"><option value="">Select a weekday</option></select>
          <fieldset id="time-section" hidden>
            <legend>Choose a time</legend>
            <div id="times" class="times"></div>
          </fieldset>
          <fieldset id="details" hidden disabled>
            <legend>Your details</legend>
            <div class="fields">
              <label>Full name<input name="customer_name" autocomplete="name" required maxlength="120"></label>
              <label>Phone number<input name="customer_phone" type="tel" autocomplete="tel" required maxlength="35"></label>
              <label class="email-field">Email<input name="customer_email" type="email" autocomplete="email" required maxlength="254"></label>
            </div>
            <p class="field-help">We use your details to manage your booking. <a href="/privacy-policy/" target="_blank" rel="noopener">Privacy policy</a>.</p>
            <button type="submit" class="button reserve">Confirm booking</button>
          </fieldset>
          <p id="status" role="status" aria-live="polite">Loading availability…</p>
          <button class="text-button" id="retry" type="button" hidden>Reload availability</button>
          <noscript><p><a href={whatsapp} target="_blank" rel="noopener">Message us on WhatsApp to arrange a session.</a></p></noscript>
        </form>
        <a class="button whatsapp-button booking-whatsapp" href={whatsappQuestion} target="_blank" rel="noopener">Not sure? Message us on WhatsApp</a>
        <div class="confirmation" id="confirmation" hidden>
          <span aria-hidden="true">✓</span>
          <h3 tabindex="-1">Your session is booked</h3>
          <p id="confirmation-slot"></p>
          <p id="confirmation-reference"></p>
          <p id="confirmation-email" hidden>We’ll send the booking details to your email.</p>
          <a href={`tel:${phone}`}>Call {phoneDisplay} on arrival</a>
        </div>
      </div>
    </section>
    <section class="session-info shell" aria-labelledby="session-title">
      <h2 id="session-title">How the session works</h2>
      <ol class="session-steps">
        <li><strong>Settle in</strong>We start with a few guided family portraits.</li>
        <li><strong>Relax and play</strong>Time to get comfortable while we capture natural moments.</li>
        <li><strong>Pick your favourites</strong>Choose 15 photos. We edit and send them within 48 hours.</li>
      </ol>
    </section>
    <section class="arrival shell" aria-labelledby="arrival-title">
      <h2 id="arrival-title">Getting here</h2>
      <p>Find the studio at <a href="https://www.google.com/maps/search/?api=1&amp;query=K32%20YY17" target="_blank" rel="noopener">K32 YY17</a>. Please call <a href={`tel:${phone}`}>{phoneDisplay}</a> when you arrive.</p>
      <p>You can park for free near the studio or in the large free car park opposite St. Peter &amp; Paul’s Church. There’s also parking at the nearby Lidl (K32 EF83).</p>
      <a class="button whatsapp-button" href={whatsapp} target="_blank" rel="noopener">Message us on WhatsApp</a>
    </section>
  </main>
  <div class="mobile-book-bar" id="mobile-book-bar" hidden>
    <a class="button primary" href="#booking">Book your session · €150</a>
    <a class="mobile-book-whatsapp" href={whatsappQuestion} target="_blank" rel="noopener" aria-label="Message us on WhatsApp">
      <svg viewBox="0 0 32 32" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M16.02 3a12.98 12.98 0 0 0-11.3 19.38L3 29l6.81-1.62A13 13 0 1 0 16.02 3Zm0 23.7c-1.9 0-3.76-.5-5.38-1.46l-.39-.23-4.04.96 1.07-3.91-.25-.4A10.7 10.7 0 1 1 16.02 26.7Z"/></svg>
    </a>
  </div>
  <a class="whatsapp-float" href={whatsapp} target="_blank" rel="noopener" aria-label="Message the Christmas photoshoot team on WhatsApp">
    <svg viewBox="0 0 32 32" width="28" height="28" fill="currentColor" aria-hidden="true">
      <path d="M16.02 3a12.98 12.98 0 0 0-11.3 19.38L3 29l6.81-1.62A13 13 0 1 0 16.02 3Zm0 23.7c-1.9 0-3.76-.5-5.38-1.46l-.39-.23-4.04.96 1.07-3.91-.25-.4A10.7 10.7 0 1 1 16.02 26.7Zm5.94-8.01c-.33-.16-1.91-.94-2.2-1.05-.29-.1-.51-.16-.72.16-.22.33-.84 1.05-1.03 1.27-.19.22-.38.24-.7.08-.33-.16-1.37-.5-2.61-1.61-.97-.86-1.62-1.93-1.81-2.25-.19-.33-.02-.5.14-.66.15-.15.32-.38.48-.57.16-.19.22-.32.32-.54.11-.22.06-.4-.02-.56-.08-.16-.72-1.76-1-2.41-.26-.63-.53-.55-.73-.56l-.62-.01c-.21 0-.56.08-.85.41-.3.32-1.14 1.11-1.14 2.71 0 1.59 1.17 3.14 1.33 3.36.16.21 2.29 3.5 5.55 4.9.78.34 1.38.54 1.85.69.78.25 1.48.21 2.04.13.63-.1 1.92-.79 2.19-1.54.27-.76.27-1.41.19-1.55-.08-.13-.29-.21-.62-.38Z"/>
    </svg>
  </a>
  <dialog class="lightbox" id="lightbox" aria-label="Photo viewer">
    <figure>
      <img id="lightbox-image" alt="" width="960" height="1440" decoding="async">
      <figcaption><span id="lightbox-caption"></span> <span id="lightbox-count" class="lightbox-count"></span></figcaption>
    </figure>
    <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close photo">×</button>
    <button type="button" class="lightbox-nav lightbox-prev" data-lightbox-prev aria-label="Previous photo">‹</button>
    <button type="button" class="lightbox-nav lightbox-next" data-lightbox-next aria-label="Next photo">›</button>
  </dialog>
  <CookieConsent />
  <script src="../scripts/christmas-booking.ts"></script>
  <script src="../scripts/christmas-lightbox.ts"></script>
  <script src="../scripts/christmas-mobile-bar.ts"></script>
</body>
</html>
