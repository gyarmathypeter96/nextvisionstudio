---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Clients from "../components/Clients.astro";
import Stats from "../components/Stats.astro";
import Services from "../components/Services.astro";
import Showreel from "../components/Showreel.astro";
import MonthlyContentPackages from "../components/MonthlyContentPackages.astro";
import HowWeWork from "../components/HowWeWork.astro";
import HomeCaseStudies from "../components/HomeCaseStudies.astro";
import ContactForm from "../components/ContactForm.astro";
import FAQ from "../components/FAQ.astro";
import QuickCall from "../components/QuickCall.astro";
---

<BaseLayout
  title="Video Production Dublin | Short-Form & Business Video"
  description="Video production in Dublin for local businesses: Reels, TikToks and business videos planned, filmed and edited for you. Monthly packages from €500 + VAT."
  canonical="https://www.nextvisionstudio.com/"
  preloadImage="/images/hero/hero-poster.webp"
>
  <main class="home-page">
    <Hero />
    <Showreel />
    <MonthlyContentPackages />
    <Clients />
    <Stats />
    <Services />
    <HomeCaseStudies />
    <HowWeWork />
    <QuickCall />
    <ContactForm />
    <FAQ />
  </main>
</BaseLayout>
