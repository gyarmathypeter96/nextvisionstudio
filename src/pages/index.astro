---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Clients from "../components/Clients.astro";
import Stats from "../components/Stats.astro";
import Services from "../components/Services.astro";
import Showreel from "../components/Showreel.astro";
import HowWeWork from "../components/HowWeWork.astro";
import LocationsMap from "../components/LocationsMap.astro";
import HomeCaseStudies from "../components/HomeCaseStudies.astro";
import PhotographyPortfolio from "../components/PhotographyPortfolio.astro";
import ContactForm from "../components/ContactForm.astro";
import FAQ from "../components/FAQ.astro";
---

<BaseLayout
  title="Content Studio Dublin | Video, Ads & Websites | NextVision"
  description="Dublin content studio for video production, paid campaigns and conversion-focused websites. Clear work built to earn qualified enquiries."
  canonical="https://www.nextvisionstudio.com/"
  preloadImage="/images/hero/hero-poster.webp"
>
  <main class="home-page">
    <Hero />
    <Showreel />
    <Clients />
    <Stats />
    <Services />
    <HomeCaseStudies />
    <HowWeWork />
    <LocationsMap />
    <PhotographyPortfolio />
    <ContactForm />
    <FAQ />
  </main>
</BaseLayout>
