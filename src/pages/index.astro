---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Clients from "../components/Clients.astro";
import Stats from "../components/Stats.astro";
import Services from "../components/Services.astro";
import LeadConversionSystem from "../components/LeadConversionSystem.astro";
import Showreel from "../components/Showreel.astro";
import VideoPortfolio from "../components/VideoPortfolio.astro";
import PhotographyPortfolio from "../components/PhotographyPortfolio.astro";
import ContactForm from "../components/ContactForm.astro";
import FAQ from "../components/FAQ.astro";
import TradesHomeServices from "../components/TradesHomeServices.astro";
---

<BaseLayout
  title="Lead Conversion Systems for Dublin Businesses | NextVision Studio"
  description="Turn more clicks and enquiries into booked work with ads, landing pages, creative content and follow-up systems for Dublin service businesses."
  canonical="https://www.nextvisionstudio.com/"
  preloadImage="/images/hero/hero-poster.jpg"
>
  <main class="home-page">
    <Hero />
    <Clients />
    <Stats />
    <LeadConversionSystem />
    <Services />
    <Showreel />
    <TradesHomeServices />
    <VideoPortfolio />
    <PhotographyPortfolio />
    <ContactForm />
    <FAQ />
  </main>
</BaseLayout>
