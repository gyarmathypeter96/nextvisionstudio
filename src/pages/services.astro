---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServicesPageHero from "../components/ServicesPageHero.astro";
import ServicePillars from "../components/ServicePillars.astro";
import ServicesProcess from "../components/ServicesProcess.astro";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "NextVision Studio",
  url: "https://www.nextvisionstudio.com/services/",
  areaServed: {
    "@type": "City",
    name: "Dublin",
  },
  serviceType: [
    "Video production",
    "Commercial photography",
    "Social media content creation",
    "Meta Ads and Google Ads management",
    "Website design and development",
    "CRM implementation and lead automation",
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "NextVision Studio creative and digital services",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Video Production Dublin",
          url: "https://www.nextvisionstudio.com/videography-dublin/",
          description: "Brand, corporate, event and short-form video production for Dublin businesses.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Commercial Photography Dublin",
          url: "https://www.nextvisionstudio.com/photography-dublin/",
          description: "Product, brand, event and business photography for Dublin companies.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Social Media Content Creation Dublin",
          url: "https://www.nextvisionstudio.com/social-media-content-creation-dublin/",
          description: "Planned short-form social content and production for Dublin businesses.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Meta Ads and Google Ads Management",
          url: "https://www.nextvisionstudio.com/google-ads-meta-ads-dublin/",
          description:
            "Paid advertising strategy, campaign setup, creative support and ongoing optimisation.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Website Design and Development Dublin",
          url: "https://www.nextvisionstudio.com/webdesigner-dublin/",
          description:
            "Fast, responsive and SEO-friendly business websites designed to generate enquiries.",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "CRM and Lead Automation Dublin",
          url: "https://www.nextvisionstudio.com/crm-lead-automation-dublin/",
          description: "CRM setup, lead pipeline design and practical follow-up workflows for Dublin businesses.",
        },
      },
    ],
  },
};
---

<BaseLayout
  title="Video, Photography & Digital Services Dublin | NextVision Studio"
  description="Explore video production, commercial photography, social media content, Google and Meta Ads, website design, and CRM automation in Dublin."
  canonical="https://www.nextvisionstudio.com/services/"
>
  <main class="services-page">
    <ServicesPageHero />
    <ServicePillars />
    <ServicesProcess />
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
</BaseLayout>

<style>
  .services-page {
    width: 100%;
    overflow: hidden;
    background: #111111;
  }
</style>
