---
import { SERVICE_CATALOG } from "../config/services";
import { SITE_URL } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import ServicesPageHero from "../components/ServicesPageHero.astro";
import ServicePillars from "../components/ServicePillars.astro";
import ServicesProcess from "../components/ServicesProcess.astro";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${SITE_URL}/services/#webpage`,
  url: `${SITE_URL}/services/`,
  name: "NextVision Studio services",
  about: { "@id": `${SITE_URL}/#business` },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: SERVICE_CATALOG.map((service, index) => ({ "@type": "ListItem", position: index + 1, name: service.title, url: `${SITE_URL}${service.href}` })),
  },
};
---

<BaseLayout
  title="Video, Photography & Digital Services Dublin | NextVision Studio"
  description="Explore video production, commercial photography, social media content, Google and Meta Ads, website design, and CRM automation in Dublin."
  canonical="https://www.nextvisionstudio.com/services/"
>
  <main class="services-page">
    <ServicesPageHero />
    <ServicePillars />
    <ServicesProcess />
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
</BaseLayout>

<style>
  .services-page {
    width: 100%;
    overflow: hidden;
    background: #111111;
  }
</style>
