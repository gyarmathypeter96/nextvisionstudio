---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutPageHero from "../components/AboutPageHero.astro";
import AboutApproach from "../components/AboutApproach.astro";
import AboutCTA from "../components/AboutCTA.astro";

const aboutSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      name: "About NextVision Studio",
      url: "https://www.nextvisionstudio.com/about/",
      description:
        "Meet Peter Gyarmathy and learn about NextVision Studio, a Dublin creative studio for videography, photography, social media, advertising and website design.",
      about: { "@id": "https://www.nextvisionstudio.com/#business" },
    },
    {
      "@type": "Person",
      "@id": "https://www.nextvisionstudio.com/#peter-gyarmathy",
      name: "Peter Gyarmathy",
      jobTitle: "Founder and filmmaker",
      image: "https://www.nextvisionstudio.com/images/about/peter-gyarmathy.webp",
      worksFor: { "@id": "https://www.nextvisionstudio.com/#business" },
      alumniOf: [{ "@type": "CollegeOrUniversity", name: "Budapest Business University" }, { "@type": "CollegeOrUniversity", name: "Hudson County Community College" }],
      hasCredential: [{ "@type": "EducationalOccupationalCredential", name: "BSc in Trade and Marketing" }, { "@type": "EducationalOccupationalCredential", name: "MSc in Management and Leadership" }],
    },

  ],
};
---

<BaseLayout
  title="Peter Gyarmathy | Filmmaker & Photographer Dublin | NextVision"
  description="Meet Peter Gyarmathy: filmmaker and photographer serving Dublin, with a marketing BSc, management MSc and creative study in the New York area."
  canonical="https://www.nextvisionstudio.com/about/"
>
  <main class="about-page">
    <AboutPageHero />
    <AboutApproach />
    <AboutCTA />
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />
</BaseLayout>

<style>
  .about-page {
    width: 100%;
    overflow: hidden;
    background: #111111;
  }
</style>
