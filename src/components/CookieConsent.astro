---
// "slim" renders a thin bottom bar that does not cover the page (used on the
// Christmas landing page). The consent logic is identical for both variants.
const { variant = "default" } = Astro.props as { variant?: "default" | "slim" };
const slim = variant === "slim";
---
<aside
  id="cookie-preferences"
  class:list={["cookie-consent", { "cookie-consent--slim": slim }]}
  aria-label="Cookie preferences"
  aria-live="polite"
  data-cookie-consent
  hidden
>
  {slim ? (
    <div>
      <p>
        <span class="cookie-consent__long">Optional cookies (Google Analytics &amp; Ads, Meta Pixel, Microsoft Clarity) help us see which ads bring visitors. The page and booking work either way.</span><span class="cookie-consent__short">Optional cookies (Google, Meta, Clarity) measure our ads.</span> <a href="/privacy-policy/">Privacy</a>
      </p>
      <p class="cookie-consent__status" data-cookie-status role="status"></p>
    </div>
  ) : (
    <div>
      <strong>Analytics preferences</strong>
      <p>
        We use optional Google Analytics, Google Ads, Meta Pixel and Microsoft
        Clarity measurement to understand which pages and campaigns generate
        enquiries. Essential site features work without these cookies. <a href="/privacy-policy/">Privacy policy</a>
      </p>
      <p data-cookie-status role="status"></p>
    </div>
  )}
  <div class="cookie-consent__actions">
    <button
      type="button"
      data-cookie-essential
    >Essential only</button>
    <button
      type="button"
      class="cookie-consent__accept"
      data-cookie-accept
    >
      {slim ? "Accept" : "Accept analytics"}
    </button>
  </div>
</aside>

<script is:inline>
  const readCookieConsent = () => {
    let storedConsent = null;
    try {
      storedConsent = localStorage.getItem("nvs-cookie-consent");
    } catch (_) {}
    return storedConsent;
  };

  const initialiseCookieConsent = () => {
    const banner = document.querySelector("[data-cookie-consent]");
    if (!banner) return;
    const updateStatus = () => {
      const status = banner.querySelector("[data-cookie-status]");
      const choice = readCookieConsent();
      if (status) status.textContent = choice === "granted" ? "Your current choice: analytics accepted."
        : choice === "denied" ? "Your current choice: essential only." : "Choose your cookie preference.";
    };
    updateStatus();

    if (banner.dataset.choiceMade === "true") {
      banner.hidden = true;
      return;
    }

    banner.hidden = Boolean(readCookieConsent()) && location.hash !== "#cookie-preferences";

    if (banner.dataset.ready === "true") return;
    banner.dataset.ready = "true";

    const saveChoice = (granted) => {
      const wasGranted = readCookieConsent() === "granted";
      banner.dataset.choiceMade = "true";

      try {
        localStorage.setItem(
          "nvs-cookie-consent",
          granted ? "granted" : "denied",
        );
      } catch (_) {}

      updateStatus();

      window.gtag?.("consent", "update", {
        analytics_storage: granted ? "granted" : "denied",
        ad_storage: granted ? "granted" : "denied",
        ad_user_data: granted ? "granted" : "denied",
        ad_personalization: granted ? "granted" : "denied",
      });

      document.dispatchEvent(new CustomEvent("nvs:consent-change", { detail: { granted } }));

      if (granted && !window.nvsTrackingExcluded) {
        window.nvsLoadTagManager?.();
      }
      banner.hidden = true;
      if (!granted && wasGranted) {
        window.clarity?.("consentv2", { ad_Storage: "denied", analytics_Storage: "denied" });
        // Stop already loaded vendor scripts on the next document. Clearing
        // first-party measurement cookies makes the withdrawal persistent.
        document.cookie.split(";").forEach((entry) => {
          const name = entry.split("=")[0].trim();
          if (!/^(_ga(?:_|$)|_gcl_|_clck$|_clsk$|_fbp$|_fbc$)/.test(name)) return;
          for (const domain of ["", location.hostname, ".nextvisionstudio.com"]) {
            document.cookie = `${name}=; Max-Age=0; path=/; SameSite=Lax${domain ? `; domain=${domain}` : ""}`;
          }
        });
        location.reload();
      }
    };

    banner
      .querySelector("[data-cookie-essential]")
      ?.addEventListener("click", () => saveChoice(false));
    banner
      .querySelector("[data-cookie-accept]")
      ?.addEventListener("click", () => saveChoice(true));
  };

  document.addEventListener("click", (event) => {
    const link = event.target?.closest?.("[data-cookie-preferences]");
    if (!link) return;
    event.preventDefault();
    const banner = document.querySelector("[data-cookie-consent]");
    if (!banner) return;
    banner.dataset.choiceMade = "false";
    const status = banner.querySelector("[data-cookie-status]");
    const choice = readCookieConsent();
    if (status) status.textContent = choice === "granted" ? "Your current choice: analytics accepted."
      : choice === "denied" ? "Your current choice: essential only." : "Choose your cookie preference.";
    banner.hidden = false;
    banner.querySelector("[data-cookie-essential]")?.focus();
  });
  if (location.pathname === "/privacy-policy/" && location.hash === "#cookie-preferences") {
    const banner = document.querySelector("[data-cookie-consent]");
    if (banner) banner.hidden = false;
  }
  initialiseCookieConsent();
  document.addEventListener("astro:page-load", initialiseCookieConsent);
</script>

<style>
  .cookie-consent,
  .cookie-consent * {
    box-sizing: border-box;
  }

  .cookie-consent[hidden] {
    display: none;
  }

  .cookie-consent {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 2000;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    width: min(720px, calc(100vw - 44px));
    padding: 20px;
    gap: 24px;
    border: 1px solid rgba(180, 220, 255, 0.24);
    border-radius: 22px;
    background: rgba(15, 20, 24, 0.94);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.52);
    color: #ffffff;
    backdrop-filter: blur(20px) saturate(140%);
  }

  .cookie-consent strong {
    display: block;
    color: #ffffff;
    font-size: 14px;
  }

  .cookie-consent p {
    margin: 7px 0 0;
    color: rgba(255, 255, 255, 0.62);
    font-size: 12px;
    line-height: 1.55;
  }

  .cookie-consent a {
    color: #cfeaff;
  }

  .cookie-consent__actions {
    display: flex;
    gap: 9px;
  }

  .cookie-consent button {
    min-height: 42px;
    padding: 0 16px;
    border: 1px solid rgba(180, 220, 255, 0.18);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.055);
    color: rgba(255, 255, 255, 0.76);
    cursor: pointer;
    font: inherit;
    font-size: 11px;
    font-weight: 800;
  }

  .cookie-consent .cookie-consent__accept {
    border-color: rgba(180, 220, 255, 0.42);
    background: linear-gradient(135deg, rgba(207, 234, 255, 0.2), rgba(155, 210, 255, 0.1));
    color: #ffffff;
  }

  .cookie-consent button:focus-visible {
    outline: 2px solid #cfeaff;
    outline-offset: 3px;
  }

  @media (max-width: 680px) {
    /* Compact on phones so the banner covers as little of the page as possible. */
    .cookie-consent {
      right: 8px;
      bottom: 8px;
      grid-template-columns: 1fr;
      width: calc(100vw - 16px);
      padding: 12px 14px;
      gap: 10px;
      border-radius: 16px;
    }

    .cookie-consent strong {
      font-size: 13px;
    }

    .cookie-consent p {
      margin-top: 4px;
      font-size: 11px;
      line-height: 1.4;
    }

    .cookie-consent__actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .cookie-consent button {
      min-height: 38px;
    }
  }

  /* Slim variant: a thin full-width bar at the bottom edge. Both buttons get
     the same visual weight so neither choice is nudged. */
  .cookie-consent--slim {
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    padding: 10px max(16px, env(safe-area-inset-right)) max(10px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left));
    gap: 14px;
    border: 0;
    border-top: 1px solid #dfd7c7;
    border-radius: 0;
    background: #fffdfa;
    box-shadow: 0 -4px 14px rgba(19, 45, 37, 0.12);
    color: #23352c;
    backdrop-filter: none;
  }

  .cookie-consent--slim p {
    margin: 0;
    color: #536057;
    font-size: 12px;
    line-height: 1.4;
  }

  .cookie-consent--slim a {
    color: #742132;
  }

  .cookie-consent__short {
    display: none;
  }

  .cookie-consent--slim .cookie-consent__status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .cookie-consent--slim .cookie-consent__actions {
    display: flex;
    gap: 8px;
  }

  .cookie-consent--slim button,
  .cookie-consent--slim .cookie-consent__accept {
    min-height: 34px;
    padding: 0 14px;
    border: 1px solid #23352c;
    background: #fffdfa;
    color: #23352c;
    font-size: 12px;
    font-weight: 700;
  }

  .cookie-consent--slim button:focus-visible {
    outline-color: #742132;
  }

  @media (max-width: 680px) {
    .cookie-consent--slim {
      right: 0;
      bottom: 0;
      grid-template-columns: minmax(0, 1fr);
      width: 100%;
      padding: 7px 12px max(7px, env(safe-area-inset-bottom));
      gap: 6px;
      border-radius: 0;
    }

    .cookie-consent--slim .cookie-consent__long {
      display: none;
    }

    .cookie-consent--slim .cookie-consent__short {
      display: inline;
    }

    .cookie-consent--slim p {
      font-size: 11px;
      line-height: 1.35;
    }

    .cookie-consent--slim .cookie-consent__actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .cookie-consent--slim button {
      min-height: 30px;
      padding: 0 10px;
      font-size: 11px;
    }
  }
</style>
