---
import ServiceScope from "../ServiceScope.astro";
import { AREA_SERVED_SCHEMA } from "../../config/site";
import { getService } from "../../config/services";
import ShortFormHero from "./ShortFormHero.astro";
import ShortFormProblem from "./ShortFormProblem.astro";
import ShortFormSystem from "./ShortFormSystem.astro";
import ShortFormResults from "./ShortFormResults.astro";
import ShortFormClientProof from "./ShortFormClientProof.astro";
import ShortFormFounder from "./ShortFormFounder.astro";
import ShortFormConsultation from "./ShortFormConsultation.astro";
import ShortFormFAQ from "./ShortFormFAQ.astro";
import ShortFormFinalCTA from "./ShortFormFinalCTA.astro";
import "../../styles/short-form.css";

const canonical = "https://www.nextvisionstudio.com/short-form-video-production-dublin/";
const serviceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebPage", "@id": canonical + "#webpage", url: canonical, name: "Short Form Video Production in Dublin", mainEntity: { "@id": canonical + "#service" }, isPartOf: { "@id": "https://www.nextvisionstudio.com/#website" } },
    {
      "@type": "Service",
      "@id": canonical + "#service",
      name: getService("shortform").title,
      serviceType: "Short-form video production for Reels, TikTok and YouTube Shorts",
      description:
        "Short video planning, filming and editing for Dublin businesses. Publishing, account management and paid promotion are separately agreed services.",
      url: canonical,
      provider: { "@id": "https://www.nextvisionstudio.com/#business" },
      areaServed: AREA_SERVED_SCHEMA,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://www.nextvisionstudio.com/" },
        { "@type": "ListItem", position: 2, name: "Short-Form Video Production Dublin", item: canonical },
      ],
    },
  ],
};
---

<main class="sf-page">
  <ShortFormHero />
  <ShortFormProblem />
  <ShortFormSystem />
  <ServiceScope slug="short-form-video-production-dublin" />
  <ShortFormResults />
  <ShortFormClientProof />
  <ShortFormFounder />
  <ShortFormConsultation />
  <ShortFormFAQ />
  <ShortFormFinalCTA />

  <a class="sf-sticky-cta sf-track-booking" href="#free-consultation">
    Get a Free Consultation
  </a>
</main>

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

<script>
  const initialiseShortFormTracking = () => {
    document.querySelectorAll<HTMLElement>(".sf-track-booking").forEach((link) => {
      if (link.dataset.tracked === "true") return;
      link.dataset.tracked = "true";
      link.addEventListener("click", () => {
        try {
          if (localStorage.getItem("nvs-cookie-consent") !== "granted") return;
        } catch (_) {
          return;
        }
        (window as any).dataLayer?.push({
          event: "strategy_call_click",
          page_location: window.location.href,
          cta_placement: link.classList.contains("sf-sticky-cta")
            ? "short-form-sticky"
            : link.closest(".sf-final")
              ? "short-form-final"
              : "short-form-hero",
        });
      });
    });
  };
  initialiseShortFormTracking();
  document.addEventListener("astro:page-load", initialiseShortFormTracking);
</script>
