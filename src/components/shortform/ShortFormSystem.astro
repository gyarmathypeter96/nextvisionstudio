---
const steps = [
  {
    number: "01",
    title: "Plan",
    text: "We agree the audience, ideas and talking points before filming, so each video has a clear purpose.",
  },
  {
    number: "02",
    title: "Film",
    text: "We film your people, products and work in one planned session, with guidance if you are new to speaking on camera.",
  },
  {
    number: "03",
    title: "Edit and deliver",
    text: "We edit the agreed videos with clear openings, subtitles and formats for your channels. You receive files ready to publish.",
  },
];
---

<section class="sf-system" aria-labelledby="sf-system-title">
  <header class="sf-section-head">
    <div class="sf-kicker">The complete system</div>
    <h2 id="sf-system-title">We Don’t Just Make Videos. We Make Them Work.</h2>
  </header>

  <ol class="sf-system__grid">
    {steps.map((step) => (
      <li>
        <span>{step.number}</span>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </li>
    ))}
  </ol>

  <p class="sf-system__close">
    Need help posting or running ads too? <strong>We can discuss a separate plan.</strong>
  </p>
</section>
