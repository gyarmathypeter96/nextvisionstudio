<a class="christmas-trigger" href="/christmas-photoshoot/" aria-label="Christmas photoshoot" data-track-id="christmas-photoshoot-icon">
  <svg viewBox="0 0 32 32" width="25" height="25" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" aria-hidden="true">
    <path d="M16 4v24M6 10l20 12M6 22l20-12M13 7l3 3 3-3M13 25l3-3 3 3M7 14l4-1-1-4M22 23l-1-4 4-1M10 23l1-4-4-1M25 14l-4-1 1-4"/>
  </svg>
  <span>Christmas photoshoot</span>
</a>
<dialog class="christmas-dialog" aria-label="Christmas photoshoot">
  <div class="christmas-toolbar">
    <a href="/christmas-photoshoot/">Open full page</a>
    <form method="dialog"><button aria-label="Close Christmas photoshoot">×</button></form>
  </div>
  <iframe title="Christmas photoshoot and booking" data-src="/christmas-photoshoot/?popup=1"></iframe>
</dialog>

<script>
  const trigger = document.querySelector<HTMLAnchorElement>(".christmas-trigger");
  const dialog = document.querySelector<HTMLDialogElement>(".christmas-dialog");
  const frame = dialog?.querySelector("iframe");
  trigger?.addEventListener("click", event => {
    if (!dialog?.showModal || !frame?.dataset.src || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    if (!frame.getAttribute("src")) frame.src = frame.dataset.src;
    dialog.showModal();
  });
  dialog?.addEventListener("click", event => {
    if (event.target === dialog) dialog.close();
  });
  dialog?.addEventListener("close", () => {
    frame?.removeAttribute("src");
    trigger?.focus();
  });
</script>

<style>
  .christmas-trigger {
    position: fixed; left: max(18px, env(safe-area-inset-left)); bottom: max(17px, env(safe-area-inset-bottom));
    z-index: 44; display: flex; align-items: center; gap: 8px; padding: 10px 13px;
    border: 1px solid #ffffff55; border-radius: 100px; background: #792132; color: white;
    text-decoration: none; box-shadow: 0 5px 22px #1a0c2440; font-size: 13px; font-weight: 700;
  }
  .christmas-trigger:hover { background: #5e1726; color: white; }
  .christmas-trigger:focus-visible, .christmas-toolbar a:focus-visible, .christmas-toolbar button:focus-visible { outline: 3px solid #ec788f; outline-offset: 2px; }
  .christmas-dialog {
    position: fixed; inset: 0; width: min(1190px, calc(100% - 34px)); height: min(920px, calc(100dvh - 34px));
    max-height: none; max-width: none; margin: auto; padding: 0; z-index: 100; overflow: hidden;
    border: 0; border-radius: 13px; background: #faf8f5; color: #25221f;
  }
  .christmas-dialog[open] { display: grid; grid-template-rows: auto minmax(0, 1fr); }
  .christmas-dialog::backdrop { background: #101015bb; }
  .christmas-toolbar { display: flex; justify-content: flex-end; align-items: center; gap: 12px; padding: 4px 9px 4px 13px; border-bottom: 1px solid #ded6cf; }
  .christmas-toolbar a { color: #792132; font-size: 13px; }
  .christmas-toolbar button { min-width: 44px; min-height: 44px; border: 0; background: transparent; color: #25221f; font-size: 27px; cursor: pointer; }
  .christmas-dialog iframe { width: 100%; height: 100%; border: 0; }
  @media (max-width: 600px) {
    .christmas-trigger { padding: 10px; }
    .christmas-trigger span { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .christmas-dialog { width: calc(100% - 12px); height: calc(100dvh - 12px); border-radius: 9px; }
  }
</style>
