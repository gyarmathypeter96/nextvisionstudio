---
import { GTM_CONTAINER_ID, ANALYTICS_HOSTS } from "../config/site";

// Every measurement tag (GA4, Google Ads, Meta Pixel, Clarity) lives in this
// Google Tag Manager container. The container loads only after consent.
const tagManagerSource = `https://www.googletagmanager.com/gtm.js?id=${GTM_CONTAINER_ID}`;
---

<script
  is:inline
  define:vars={{ tagManagerSource, analyticsHosts: ANALYTICS_HOSTS }}
>
  (() => {
  if (!analyticsHosts.includes(window.location.hostname) || window.nvsTrackingExcluded) return;

  window.dataLayer = window.dataLayer || [];
  window.gtag = window.gtag || function () {
    window.dataLayer.push(arguments);
  };

  // Deliberate QA runs remain identifiable in GA4, including automatic events.
  // This sets no visitor identity and never bypasses consent or owner exclusion.
  try {
    const debugChoice = new URL(location.href).searchParams.get("nvs_debug");
    if (debugChoice === "1") sessionStorage.setItem("nvs-measurement-qa", "1");
    if (debugChoice === "0") sessionStorage.removeItem("nvs-measurement-qa");
    if (sessionStorage.getItem("nvs-measurement-qa") === "1") {
      window.gtag("set", { debug_mode: true, traffic_type: "qa", measurement_traffic: "qa" });
    } else {
      window.gtag("set", { measurement_traffic: "visitor" });
    }
  } catch (_) {}

  let storedConsent = null;
  try {
    storedConsent = localStorage.getItem("nvs-cookie-consent");
  } catch (_) {}

  const consentGranted = storedConsent === "granted";

  window.gtag("consent", "default", {
    analytics_storage: consentGranted ? "granted" : "denied",
    ad_storage: consentGranted ? "granted" : "denied",
    ad_user_data: consentGranted ? "granted" : "denied",
    ad_personalization: consentGranted ? "granted" : "denied",
    functionality_storage: "granted",
    security_storage: "granted",
    wait_for_update: 500,
  });

  window.nvsLoadTagManager = window.nvsLoadTagManager || function () {
    if (window.nvsTrackingExcluded) return;
    // Recheck consent when a deferred loader actually runs.
    try {
      if (localStorage.getItem("nvs-cookie-consent") !== "granted") return;
    } catch (_) { return; }
    if (document.querySelector("script[data-nvs-gtm]")) return;

    window.dataLayer.push({ "gtm.start": Date.now(), event: "gtm.js" });

    const script = document.createElement("script");
    script.async = true;
    script.src = tagManagerSource;
    script.dataset.nvsGtm = "true";
    document.head.appendChild(script);
  };

  if (consentGranted) {
    // The script is already asynchronous. Waiting for window.load plus idle
    // loses short consented visits while large images/video are loading.
    window.nvsLoadTagManager();
  }
  })();
</script>
