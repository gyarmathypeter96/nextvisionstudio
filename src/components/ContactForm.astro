---
import { CRM_FORM_ENDPOINT } from "../config/forms";
import { SERVICE_CATALOG, type ServiceKey } from "../config/services";
import { GOOGLE_RATING, GOOGLE_REVIEWS_URL } from "../config/site";
interface Props { serviceKey?: ServiceKey; source?: string }
const { serviceKey, source = "homepage-contact" } = Astro.props;
// Service pages quote per brief and must not show prices; the home page shows
// the owner-approved monthly package price.
---

<section class="contact" id="contact-form" aria-labelledby="contact-title">
  <header class="contact__header">
    <h2 id="contact-title">Get a video quote in 60 seconds.</h2>
    <p>Three short steps. We reply with a clear plan and price, usually within one working day.</p>
  </header>

  <form
    class="contact__form"
    action={CRM_FORM_ENDPOINT}
    method="POST"
    data-crm-form
    data-quote-steps
  >
    <p class="contact__progress" data-step-progress aria-live="polite" hidden>Step <span data-step-current>1</span> of 3</p>
    <input
      type="hidden"
      name="redirect"
      value={`https://www.nextvisionstudio.com/quotesend/?submitted=1&source=${source}`}
    />
    <input
      type="hidden"
      name="subject"
      value="New project enquiry from the NextVision Studio website"
    />
    <input type="hidden" name="from_name" value="NextVision Studio Website" />
    <input type="hidden" name="landing_page" value={Astro.url.pathname} />
    <input type="hidden" name="content_package" value="" />
    <div class="contact__package" data-package-summary hidden role="status" aria-live="polite">
      <span>Your selected package</span>
      <strong data-package-label></strong>
      <button type="button" data-clear-package>Clear selection</button>
    </div>

    <div class="contact__botcheck" aria-hidden="true">
      <input
        type="checkbox"
        name="botcheck"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <fieldset class="contact__step" data-step="1" data-step-name="project">
      <legend>What do you need?</legend>
      <div class="contact__field">
        <label for="contact-service">Which service do you need? <span>(required)</span></label>
        <select id="contact-service" name="service" required>
          <option value="" disabled selected={!serviceKey}>Select a service</option>
          {SERVICE_CATALOG.map((service) => <option value={service.title} selected={service.key === serviceKey}>{service.title}</option>)}
          <option value="Not sure yet">I am not sure yet</option>
        </select>
      </div>
      <div class="contact__field">
        <span class="contact__label" id="contact-timeline-label">When do you need it?</span>
        <div class="contact__choices" role="radiogroup" aria-labelledby="contact-timeline-label">
          <label><input type="radio" name="timeline" value="As soon as possible" /> As soon as possible</label>
          <label><input type="radio" name="timeline" value="Within 1-2 months" /> Within 1–2 months</label>
          <label><input type="radio" name="timeline" value="Just planning" /> Just planning</label>
        </div>
      </div>
      <button type="button" class="contact__next" data-step-next hidden>Next</button>
    </fieldset>

    <fieldset class="contact__step" data-step="2" data-step-name="details">
      <legend>Your project</legend>
      <div class="contact__field">
        <label for="contact-message">A little about your project <span>(required)</span></label>
        <textarea
          id="contact-message"
          name="message"
          placeholder="For example: 4 Reels a month for our clinic, or a 2-minute video for our website."
          rows="4"
          required
        ></textarea>
      </div>
      <div class="contact__nav">
        <button type="button" class="contact__back" data-step-back hidden>Back</button>
        <button type="button" class="contact__next" data-step-next hidden>Next</button>
      </div>
    </fieldset>

    <fieldset class="contact__step" data-step="3" data-step-name="contact">
      <legend>Where should we send your quote?</legend>
      <div class="contact__field">
        <label for="contact-name">Name <span>(required)</span></label>
        <input id="contact-name" type="text" name="name" placeholder="Your name" autocomplete="name" required />
      </div>
      <div class="contact__field">
        <label for="contact-email">Email <span>(required)</span></label>
        <input id="contact-email" type="email" name="email" placeholder="you@example.com" autocomplete="email" inputmode="email" required />
      </div>
      <div class="contact__field">
        <label for="contact-phone">Phone number <span>(required)</span></label>
        <input id="contact-phone" type="tel" name="phone" placeholder="+353" autocomplete="tel" inputmode="tel" required />
      </div>
      <div class="contact__nav">
        <button type="button" class="contact__back" data-step-back hidden>Back</button>
        <button type="submit">
          <span>Get my quote</span>
        </button>
      </div>
      <ul class="contact__trust">
        <li><a href={GOOGLE_REVIEWS_URL} target="_blank" rel="noopener">★ {GOOGLE_RATING.value} on Google ({GOOGLE_RATING.count} reviews)</a></li>
        {!serviceKey && <li>Monthly video packages from €350 + VAT</li>}
        <li>No obligation. We reply within one working day.</li>
      </ul>
    </fieldset>

    <p class="contact__privacy">
      Your details are used only to respond to your enquiry.
    </p>
  </form>
</section>

<script>
  document.querySelectorAll<HTMLSelectElement>('#contact-form [name="service"]').forEach((service) => {
    service.addEventListener("change", () => {
      if (service.value === "Monthly Social Media Content") return;
      const form = service.closest("form");
      const field = form?.querySelector<HTMLInputElement>('[name="content_package"]');
      const summary = form?.querySelector<HTMLElement>("[data-package-summary]");
      if (field) field.value = "";
      if (summary) summary.hidden = true;
    });
  });
  document.querySelectorAll<HTMLButtonElement>("[data-clear-package]").forEach((button) => {
    button.addEventListener("click", () => {
      const form = button.closest("form");
      const field = form?.querySelector<HTMLInputElement>('[name="content_package"]');
      const summary = form?.querySelector<HTMLElement>("[data-package-summary]");
      if (field) field.value = "";
      if (summary) summary.hidden = true;
    });
  });

  // Progressive enhancement: without JavaScript every step is visible and the
  // form posts as before. Submission and measurement stay in LeadAttribution.
  document.querySelectorAll<HTMLFormElement>("form[data-quote-steps]").forEach((form) => {
    const steps = [...form.querySelectorAll<HTMLFieldSetElement>("[data-step]")];
    const progress = form.querySelector<HTMLElement>("[data-step-progress]");
    const current = form.querySelector<HTMLElement>("[data-step-current]");
    let active = 0;

    const show = (index: number, focus = true) => {
      active = index;
      steps.forEach((step, stepIndex) => step.classList.toggle("is-active", stepIndex === index));
      if (current) current.textContent = String(index + 1);
      if (focus) steps[index].querySelector<HTMLElement>("input:not([type=hidden]), select, textarea")?.focus({ preventScroll: true });
    };

    const stepIsValid = (step: HTMLFieldSetElement) =>
      [...step.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input, select, textarea")]
        .every((field) => field.reportValidity());

    form.querySelectorAll<HTMLButtonElement>("[data-step-next]").forEach((button) => {
      button.addEventListener("click", () => {
        if (!stepIsValid(steps[active])) return;
        const next = Math.min(active + 1, steps.length - 1);
        show(next);
        form.dispatchEvent(new CustomEvent("nvs:form-step", {
          detail: { step: next + 1, stepName: steps[next].dataset.stepName || "" },
        }));
      });
    });
    form.querySelectorAll<HTMLButtonElement>("[data-step-back]").forEach((button) => {
      button.addEventListener("click", () => show(Math.max(active - 1, 0)));
    });

    // A required field on a hidden step would block submit without a visible
    // message, so open the step that holds it.
    form.addEventListener("invalid", (event) => {
      const step = (event.target as Element).closest<HTMLFieldSetElement>("[data-step]");
      const index = step ? steps.indexOf(step) : -1;
      if (index >= 0 && index !== active) {
        show(index, false);
        setTimeout(() => (event.target as HTMLInputElement).reportValidity());
      }
    }, true);

    form.querySelectorAll<HTMLElement>("[data-step-next], [data-step-back]").forEach((button) => { button.hidden = false; });
    if (progress) progress.hidden = false;
    form.classList.add("is-stepped");
    show(0, false);
  });
</script>

<style>
  .contact,
  .contact * {
    box-sizing: border-box;
  }

  .contact {
    width: 100%;
    margin: 0;
    padding: 96px 24px 104px;
    background: #111111;
    color: #ffffff;
  }

  .contact__header {
    width: min(100%, 820px);
    margin: 0 auto 42px;
    text-align: center;
  }

  .contact__kicker {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 22px;
    padding: 10px 17px;

    border: 1px solid rgba(180, 220, 255, 0.28);
    border-radius: 999px;
    background: rgba(155, 210, 255, 0.08);
    color: #cfeaff;
    font-size: 12px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact__header h2 {
    margin: 0;
    color: #ffffff;
    font-size: clamp(40px, 5vw, 60px);
    font-weight: 900;
    line-height: 0.96;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .contact__header p {
    width: min(100%, 720px);
    margin: 24px auto 0;
    color: rgba(255, 255, 255, 0.66);
    font-size: clamp(16px, 1.8vw, 19px);
    font-weight: 500;
    line-height: 1.58;
    text-wrap: balance;
  }

  .contact__form {
    width: min(100%, 760px);
    margin: 0 auto;
    padding: 42px;

    border: 1px solid rgba(180, 220, 255, 0.16);
    border-radius: 28px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0.025)),
      #171717;
    box-shadow:
      0 24px 80px rgba(0, 0, 0, 0.35),
      0 0 42px rgba(155, 210, 255, 0.05);
  }

  .contact__botcheck {
    display: none;
  }

  .contact__package[hidden] { display: none; }
  .contact__package { display: grid; gap: 8px; padding: 20px; margin-bottom: 28px; border: 1px solid rgba(180,220,255,.3); border-radius: 16px; background: rgba(155,210,255,.06); }
  .contact__package > span { color: #cfeaff; font-size: 11px; }
  .contact__package > strong { font-size: 16px; line-height: 1.5; }
  .contact__package > button { width: fit-content; min-height: 44px; padding: 10px 0; margin: 0; border: 0; background: none; color: rgba(255,255,255,.65); font-size: 12px; text-decoration: underline; box-shadow: none; }

  .contact__field {
    margin-bottom: 18px;
  }

  .contact__field label {
    display: block;
    margin-bottom: 8px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 14px;
    font-weight: 700;
  }

  .contact__field label span {
    color: rgba(255, 255, 255, 0.62);
    font-size: 12px;
    font-weight: 600;
  }

  .contact__field input,
  .contact__field textarea,
  .contact__field select {
    display: block;
    width: 100%;
    min-height: 54px;
    padding: 15px 18px;

    border: 1px solid rgba(180, 220, 255, 0.14);
    border-radius: 16px;
    outline: none;
    background: rgba(255, 255, 255, 0.055);
    color: #ffffff;
    font: inherit;
    font-size: 16px;
    font-weight: 500;

    transition:
      border-color 250ms ease,
      background 250ms ease,
      box-shadow 250ms ease;
  }

  .contact__field textarea {
    min-height: 150px;
    resize: vertical;
  }

  .contact__field input::placeholder,
  .contact__field textarea::placeholder {
    color: rgba(255, 255, 255, 0.38);
  }

  .contact__field input:focus,
  .contact__field textarea:focus,
  .contact__field select:focus {
    border-color: rgba(155, 210, 255, 0.58);
    background: rgba(255, 255, 255, 0.075);
    box-shadow:
      0 0 0 4px rgba(155, 210, 255, 0.1),
      0 0 24px rgba(155, 210, 255, 0.1);
  }

  .contact__form button[type="submit"] {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 58px;
    margin-top: 6px;
    overflow: hidden;

    border: 1px solid rgba(180, 220, 255, 0.32);
    border-radius: 999px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.16), rgba(155, 210, 255, 0.1)),
      rgba(255, 255, 255, 0.08);
    color: #ffffff;
    cursor: pointer;

    font: inherit;
    font-size: 16px;
    font-weight: 900;
    letter-spacing: 0.055em;
    text-transform: uppercase;

    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.34),
      inset 0 -1px 1px rgba(255, 255, 255, 0.08),
      0 0 28px rgba(155, 210, 255, 0.1),
      0 22px 48px rgba(0, 0, 0, 0.32);

    transition:
      transform 280ms ease,
      background 280ms ease,
      box-shadow 280ms ease;
  }

  .contact__form button[type="submit"]::after {
    content: "";
    position: absolute;
    top: -70%;
    left: -90%;
    width: 70%;
    height: 240%;

    background: linear-gradient(
      120deg,
      transparent,
      rgba(255, 255, 255, 0.45),
      transparent
    );
    opacity: 0.45;
    pointer-events: none;
    transform: rotate(18deg);
    transition: left 750ms ease;
  }

  .contact__form button[type="submit"] span {
    position: relative;
    z-index: 1;
  }

  .contact__form button[type="submit"]:hover {
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.22), rgba(155, 210, 255, 0.16)),
      rgba(255, 255, 255, 0.12);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.42),
      0 0 36px rgba(155, 210, 255, 0.18),
      0 26px 56px rgba(0, 0, 0, 0.4);
    transform: translateY(-2px);
  }

  .contact__form button[type="submit"]:hover::after {
    left: 130%;
  }

  .contact__form button:focus-visible {
    outline: 2px solid #cfeaff;
    outline-offset: 5px;
  }

  .contact__privacy {
    margin: 16px 0 0;
    color: rgba(255, 255, 255, 0.62);
    font-size: 13px;
    line-height: 1.45;
    text-align: center;
  }

  @media (max-width: 767px) {
    .contact {
      padding: 90px 16px 94px;
    }

    .contact__header {
      margin-bottom: 42px;
    }

    .contact__header h2 {
      font-size: clamp(39px, 11vw, 52px);
    }

    .contact__form {
      padding: 30px 20px;
      border-radius: 24px;
    }

    .contact__field input,
    .contact__field textarea {
      font-size: 16px;
    }

    .contact__form button {
      min-height: 56px;
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact__field input,
    .contact__field textarea,
    .contact__form button,
    .contact__form button::after {
      transition: none;
    }
  }

  .contact__step { min-width: 0; margin: 0; padding: 0; border: 0; }
  .contact__step + .contact__step { margin-top: 8px; }
  .contact__step legend { margin: 0 0 18px; padding: 0; color: #ffffff; font-size: 20px; font-weight: 800; }
  .contact__form.is-stepped .contact__step { display: none; }
  .contact__form.is-stepped .contact__step.is-active { display: block; }
  .contact__progress[hidden] { display: none; }
  .contact__progress { margin: 0 0 14px; color: #cfeaff; font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .contact__label { display: block; margin-bottom: 10px; color: rgba(255,255,255,.82); font-size: 14px; font-weight: 700; }
  .contact__choices { display: flex; flex-wrap: wrap; gap: 10px; }
  .contact__choices label { display: inline-flex; align-items: center; gap: 10px; min-height: 48px; margin: 0; padding: 12px 16px; border: 1px solid rgba(180,220,255,.18); border-radius: 999px; background: rgba(255,255,255,.04); color: #ffffff; font-size: 15px; font-weight: 600; cursor: pointer; }
  .contact__choices label:has(input:checked) { border-color: rgba(155,210,255,.7); background: rgba(155,210,255,.12); }
  .contact__field .contact__choices input { display: inline-block; width: 18px; min-height: 0; height: 18px; margin: 0; padding: 0; accent-color: #9bd2ff; }
  .contact__nav { display: flex; gap: 12px; align-items: stretch; }
  .contact__nav > button[type="submit"] { flex: 1; }
  .contact__next, .contact__back { min-height: 58px; padding: 0 26px; border: 1px solid rgba(180,220,255,.3); border-radius: 999px; background: rgba(155,210,255,.12); color: #ffffff; font: inherit; font-size: 16px; font-weight: 800; cursor: pointer; }
  .contact__next { flex: 1; width: 100%; background: #cfeaff; color: #111a22; }
  .contact__back { background: transparent; }
  .contact__next[hidden], .contact__back[hidden] { display: none; }
  .contact__trust { display: grid; gap: 6px; margin: 18px 0 0; padding: 0; list-style: none; color: rgba(255,255,255,.7); font-size: 14px; text-align: center; }
  .contact__trust a { color: #cfeaff; font-weight: 700; }
</style>
