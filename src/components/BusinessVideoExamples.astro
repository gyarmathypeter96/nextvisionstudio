---
const projects = [
  { title: "VentSolve", type: "Explain a service", id: "SUeoIgRtH0I", href: "/case-studies/ventsolve-content-production/", text: "A promotional film for an Irish ventilation and mould removal business." },
  { title: "SG Studios Dublin", type: "Introduce a business", id: "fLzjvPVHzAc", href: "/case-studies/sg-studios-dublin-podcast-studio-content/", text: "Promotional content showing a Dublin podcast and video studio." },
  { title: "The Macaron Boutique", type: "Show a product", id: "GTzSrbR4-k4", href: "/case-studies/macaron-boutique-product-video/", text: "A product film for a boutique in Alicante, showing food, detail and the brand experience." },
];
---
<section class="business-examples" id="video-examples" aria-labelledby="business-examples-title">
  <header><h2 id="business-examples-title">Real businesses. Videos with a purpose.</h2><p>Watch the work, then see the brief and production choices behind each project.</p></header>
  <div class="business-examples__grid">
    {projects.map((project) => <article>
      <div class="business-examples__player">
        <button type="button" data-business-video={project.id} data-title={project.title} aria-label={`Play ${project.title} video on YouTube`}>
          <img src={`/images/portfolio/${project.id}.webp`} width="640" height="360" alt="" loading="lazy" decoding="async" />
          <span aria-hidden="true">▶</span>
        </button>
      </div>
      <small>{project.type}</small><h3>{project.title}</h3><p>{project.text}</p>
      <a href={project.href}>Read the case study <span aria-hidden="true">→</span></a>
    </article>)}
  </div>
  <p class="business-examples__note">Playing a video loads the YouTube player. No player loads before you click.</p>
</section>
<script>
  document.querySelectorAll<HTMLButtonElement>("[data-business-video]").forEach((button) => {
    button.addEventListener("click", () => {
      const player = document.createElement("iframe");
      player.src = `https://www.youtube-nocookie.com/embed/${button.dataset.businessVideo}?autoplay=1`;
      player.title = `${button.dataset.title} project video`;
      player.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      player.allowFullscreen = true;
      button.replaceWith(player);
    }, { once: true });
  });
</script>
<style>
  .business-examples { width: min(100% - 48px, 1180px); margin: 0 auto; padding: 70px 0 32px; color: #fff; }
  .business-examples header { max-width: 880px; margin-bottom: 30px; }
  .business-examples h2 { margin: 0; font-size: clamp(34px,4.3vw,54px); line-height: 1.06; text-wrap: balance; }
  .business-examples p { color: rgba(255,255,255,.7); line-height: 1.65; }
  .business-examples__grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 22px; }
  .business-examples article { min-width: 0; border: 1px solid rgba(180,220,255,.2); border-radius: 24px; overflow: hidden; background: #171b1f; padding-bottom: 24px; }
  .business-examples__player { aspect-ratio: 16 / 9; background: #080a0c; }
  .business-examples__player button { position: relative; width: 100%; height: 100%; padding: 0; border: 0; color: #fff; background: transparent; cursor: pointer; }
  .business-examples__player img { width: 100%; height: 100%; object-fit: cover; }
  .business-examples__player button > span { position: absolute; inset: 50% auto auto 50%; transform: translate(-50%,-50%); display: grid; place-items: center; width: 58px; height: 58px; border-radius: 50%; border: 1px solid rgba(207,234,255,.55); background: rgba(10,17,24,.7); backdrop-filter: blur(12px); }
  .business-examples__player iframe { width: 100%; height: 100%; border: 0; }
  .business-examples small, .business-examples h3, .business-examples article p, .business-examples article a { display: block; margin: 16px 24px 0; }
  .business-examples small { color: #cfeaff; font-weight: 750; }
  .business-examples h3 { font-size: 23px; margin-top: 8px; }
  .business-examples a { color: #cfeaff; font-weight: 750; text-underline-offset: 5px; }
  .business-examples__note { font-size: 13px; }
  .business-examples button:focus-visible { outline: 3px solid #cfeaff; outline-offset: -4px; }
  @media (max-width: 760px) { .business-examples { width: calc(100% - 32px); padding-top: 48px; } .business-examples__grid { grid-template-columns: 1fr; } }
</style>
