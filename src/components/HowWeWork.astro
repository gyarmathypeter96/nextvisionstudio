---
const stages = [
  {
    title: "Video and photography",
    description: "Create clear, useful content that shows what you do and gives people a reason to remember you.",
    links: [
      { label: "Videography", href: "/short-form-video-production-dublin/" },
      { label: "Photography", href: "/photography-dublin/" },
    ],
  },
  {
    title: "Google and Meta ads",
    description: "Put the strongest message in front of a relevant audience, then measure the enquiries that follow.",
    links: [{ label: "Advertising", href: "/google-ads-meta-ads-dublin/" }],
  },
  {
    title: "CRM and automation",
    description: "Keep new enquiries in one clear process, with useful next steps for your team and timely follow-up for customers.",
    links: [{ label: "CRM and lead automation", href: "/crm-lead-automation-dublin/" }],
  },
];
---

<section class="process" id="how-we-work" aria-labelledby="process-title">
  <div class="process__heading">

    <h2 id="process-title">From first impression to follow-up.</h2>
    <p>We can help shape the full path: useful content, well-planned advertising and a clear way to handle the enquiries it creates. Start at the stage your business needs most.</p>
  </div>

  <ol class="process__steps">
    {stages.map((stage, index) => (
      <li class="process__step">


        <h3>{stage.title}</h3>
        <p class="process__description">{stage.description}</p>
        <nav aria-label={`${stage.title} services`}>
          {stage.links.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
        {index < stages.length - 1 && <span class="process__connector" aria-hidden="true"><svg viewBox="0 0 48 24" fill="none"><path d="M3 12h40M36 5l7 7-7 7" /></svg></span>}
      </li>
    ))}
  </ol>

  <p class="process__note">Already have content, ads or a CRM? We can begin with the part that needs attention.</p>
</section>

<style>
  .process, .process * { box-sizing: border-box; }
  .process { width: 100%; padding: clamp(76px, 9vw, 122px) max(24px, calc((100vw - 1180px) / 2)); background: #080a0c; color: #fff; }
  .process__heading { max-width: 760px; margin-bottom: 48px; }
  .process__eyebrow { margin: 0 0 17px; color: #a8d7ff; font-size: 11px; font-weight: 850; letter-spacing: .15em; text-transform: uppercase; }
  .process h2 { max-width: 740px; margin: 0; color: #fff; font-size: clamp(40px, 6vw, 72px); font-weight: 620; line-height: .98; letter-spacing: -.065em; text-wrap: balance; }
  .process__heading > p:last-child { max-width: 650px; margin: 22px 0 0; color: rgba(255,255,255,.7); font-size: clamp(16px, 1.6vw, 19px); line-height: 1.6; }
  .process__steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px; margin: 0; padding: 0; list-style: none; }
  .process__step { position: relative; min-width: 0; padding: clamp(24px, 3vw, 34px); border: 1px solid rgba(207,234,255,.17); border-radius: 20px; background: linear-gradient(145deg, rgba(168,215,255,.075), transparent 62%), #101316; }
  .process__number { display: inline-flex; width: 38px; height: 38px; align-items: center; justify-content: center; border: 1px solid rgba(168,215,255,.55); border-radius: 50%; color: #cfeaff; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
  .process__label { margin: 24px 0 9px; color: #a8d7ff; font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .process h3 { margin: 0; color: #fff; font-size: clamp(23px, 2.5vw, 30px); font-weight: 620; letter-spacing: -.04em; line-height: 1.12; }
  .process__description { min-height: 79px; margin: 15px 0 22px; color: rgba(255,255,255,.68); font-size: 15px; line-height: 1.6; }
  .process__step nav { display: flex; flex-wrap: wrap; gap: 10px; }
  .process__step nav a { display: inline-flex; min-height: 38px; align-items: center; padding: 8px 12px; border: 1px solid rgba(207,234,255,.2); border-radius: 999px; color: #dff1ff; font-size: 12px; font-weight: 700; text-decoration: none; }
  .process__step nav a:hover, .process__step nav a:focus-visible { border-color: #a8d7ff; background: rgba(168,215,255,.1); }
  .process__connector { position: absolute; top: 50%; right: -49px; display: grid; width: 48px; height: 24px; place-items: center; color: #a8d7ff; transform: translateY(-50%); pointer-events: none; }
  .process__connector svg { display: block; width: 40px; height: 24px; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .process__note { margin: 22px 0 0; color: rgba(255,255,255,.55); font-size: 13px; line-height: 1.5; }
  @media (max-width: 760px) {
    .process { padding: 76px 20px 84px; }
    .process__heading { margin-bottom: 32px; }
    .process__steps { grid-template-columns: 1fr; gap: 44px; }
    .process__step { padding: 24px; }
    .process__description { min-height: 0; margin-bottom: 18px; }
    .process__connector { top: auto; right: auto; bottom: -35px; left: 50%; transform: translateX(-50%) rotate(90deg); }
  }
</style>
