---
const steps = [
  ["01", "Align", "We get clear on the audience, the job the work needs to do and the right production plan before the camera rolls."],
  ["02", "Shape", "We turn the brief into a visual direction, a tight story and a practical route through approvals."],
  ["03", "Create", "One focused team takes the project from shoot through edit, colour, sound and every format it needs."],
  ["04", "Release", "We deliver work ready for the channels that matter, then use what we learn to make the next round stronger."],
];
---

<section class="process" id="how-we-work" aria-labelledby="process-title">
  <div class="process__intro">
    <p class="process__eyebrow">How we work</p>
    <h2 id="process-title">Built to keep<br />moving forward.</h2>
    <p>Good work does not disappear after delivery. We make the process clear, collaborative and built around what happens next.</p>
  </div>

  <ol class="process__steps">
    {steps.map(([number, title, description]) => (
      <li>
        <span class="process__number">{number}</span>
        <div>
          <h3>{title}</h3>
          <p>{description}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .process, .process * { box-sizing: border-box; }
  .process { display: grid; grid-template-columns: minmax(260px, .72fr) minmax(0, 1fr); gap: clamp(48px, 12vw, 190px); width: 100%; margin: 0; padding: clamp(88px, 12vw, 170px) max(24px, calc((100vw - 1180px) / 2)); overflow: hidden; background: #f2f4f2; color: #111827; }
  .process__intro { max-width: 460px; }
  .process__eyebrow { margin: 0 0 22px; color: #087af5; font-size: 11px; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
  .process h2 { margin: 0; font-size: clamp(48px, 6vw, 86px); font-weight: 650; line-height: .9; letter-spacing: -.07em; text-wrap: balance; }
  .process__intro > p:last-child { margin: 30px 0 0; color: #536176; font-size: clamp(17px, 1.75vw, 21px); line-height: 1.5; text-wrap: balance; }
  .process__steps { position: relative; margin: 0; padding: 0 0 2px 58px; list-style: none; }
  .process__steps::before { content: ""; position: absolute; top: 0; bottom: 0; left: 0; width: 12px; border-radius: 999px; background: linear-gradient(#087af5 0 84%, rgba(183,190,196,.55) 84%); }
  .process__steps::after { content: ""; position: absolute; bottom: -14px; left: 1px; width: 10px; height: 10px; border-right: 3px solid #087af5; border-bottom: 3px solid #087af5; transform: rotate(45deg); }
  .process__steps li { display: grid; grid-template-columns: 64px minmax(0,1fr); gap: 20px; padding: 0 0 36px; }
  .process__steps li + li { padding-top: 35px; border-top: 1px solid rgba(20,33,52,.13); }
  .process__steps li:last-child { padding-bottom: 0; }
  .process__number { padding-top: 7px; color: #087af5; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 17px; letter-spacing: .09em; }
  .process h3 { margin: 0; font-size: clamp(30px, 3.1vw, 48px); font-weight: 560; line-height: 1; letter-spacing: -.05em; }
  .process__steps p { max-width: 650px; margin: 17px 0 0; color: #59677d; font-size: clamp(16px, 1.55vw, 20px); line-height: 1.48; }
  @media (max-width: 820px) { .process { grid-template-columns: 1fr; gap: 58px; padding: 84px 24px 96px; } .process__intro { max-width: 580px; } .process__steps { padding-left: 42px; } .process__steps::before { width: 9px; } .process__steps li { grid-template-columns: 1fr; gap: 6px; } .process__number { padding-top: 0; } .process h3 { font-size: 38px; } }
</style>
