---
const steps = [
  ["01", "Brief", "We start with the outcome: who this is for, what it needs to change and how we will know it worked."],
  ["02", "Creative direction", "You get a clear treatment—the story, visual direction and decisions behind it—before production begins."],
  ["03", "Production, wherever", "Our core crew and trusted network keep every shoot in Dublin or beyond feeling like one joined-up production."],
  ["04", "Learning", "We look at the work against the goal, then capture what is worth carrying into the next release."],
  ["05", "Optimisation", "The next round gets sharper because the work keeps improving after delivery—not just ending there."],
];
---

<section class="process" id="how-we-work" aria-labelledby="process-title">
  <div class="process__intro">
    <p class="process__eyebrow">How we work</p>
    <h2 id="process-title">A process that<br />keeps working.</h2>
    <p>We treat each production as the start of a useful system, not the end of a shoot.</p>

    <div class="process__key" aria-label="Process key">
      <span><i class="process__key-swatch process__key-swatch--traditional"></i>Typical hand-off</span>
      <span><i class="process__key-swatch process__key-swatch--nextvision"></i>NextVision ongoing loop</span>
    </div>
  </div>

  <div class="process__track" aria-hidden="true"><i></i></div>
  <ol class="process__steps">
    {steps.map(([number, title, description]) => (
      <li>
        <span class="process__number">{number}</span>
        <div>
          <h3>{title}</h3>
          <p>{description}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .process, .process * { box-sizing: border-box; }
  .process { display: grid; grid-template-columns: minmax(260px, .72fr) 28px minmax(0, 1fr); gap: clamp(40px, 7vw, 108px); width: 100%; margin: 0; padding: clamp(88px, 12vw, 170px) max(24px, calc((100vw - 1180px) / 2)); overflow: hidden; background: #050505; color: #fff; }
  .process__intro { max-width: 430px; }
  .process__eyebrow { margin: 0 0 22px; color: #178aff; font-size: 11px; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
  .process h2 { margin: 0; color: #fff; font-size: clamp(48px, 6vw, 82px); font-weight: 650; line-height: .9; letter-spacing: -.07em; text-wrap: balance; }
  .process__intro > p:last-of-type { margin: 30px 0 0; color: rgba(255,255,255,.78); font-size: clamp(17px, 1.75vw, 21px); line-height: 1.5; text-wrap: balance; }
  .process__key { display: grid; gap: 15px; margin-top: 64px; color: rgba(255,255,255,.7); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; }
  .process__key span { display: flex; align-items: center; gap: 14px; }
  .process__key-swatch { display: inline-block; width: 28px; height: 28px; border-radius: 7px; }
  .process__key-swatch--traditional { background: repeating-linear-gradient(45deg, #929292 0 6px, #505050 6px 12px); }
  .process__key-swatch--nextvision { background: #178aff; }
  .process__track { position: relative; min-height: 100%; }
  .process__track::before { content: ""; position: absolute; top: 0; bottom: 14px; left: 0; width: 10px; border-radius: 999px; background: repeating-linear-gradient(45deg, #8b8b8b 0 7px, #484848 7px 14px); }
  .process__track i { position: absolute; z-index: 1; top: 0; bottom: 0; left: 18px; display: block; width: 10px; border-radius: 999px; background: #178aff; }
  .process__track i::after { content: ""; position: absolute; bottom: -7px; left: 1px; width: 7px; height: 7px; border-right: 3px solid #178aff; border-bottom: 3px solid #178aff; transform: rotate(45deg); }
  .process__steps { margin: 0; padding: 0 0 2px; list-style: none; }
  .process__steps li { display: grid; grid-template-columns: 66px minmax(0,1fr); gap: 20px; padding: 0 0 39px; }
  .process__steps li + li { padding-top: 37px; border-top: 1px solid rgba(255,255,255,.18); }
  .process__steps li:last-child { padding-bottom: 0; }
  .process__number { padding-top: 7px; color: #178aff; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 17px; letter-spacing: .09em; }
  .process h3 { margin: 0; color: #fff; font-size: clamp(30px, 3.1vw, 47px); font-weight: 560; line-height: 1; letter-spacing: -.05em; }
  .process__steps p { max-width: 650px; margin: 17px 0 0; color: rgba(255,255,255,.76); font-size: clamp(16px, 1.55vw, 20px); line-height: 1.48; }
  @media (max-width: 820px) {
    .process { grid-template-columns: 28px 1fr; gap: 25px; padding: 84px 24px 96px; }
    .process__intro { grid-column: 1 / -1; max-width: 590px; }
    .process__key { margin-top: 42px; }
    .process__steps li { grid-template-columns: 1fr; gap: 6px; }
    .process__number { padding-top: 0; }
    .process h3 { font-size: 38px; }
  }
</style>
