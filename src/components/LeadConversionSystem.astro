<script>
  const setupLeadFlow = () => {
    const flow = document.querySelector<HTMLElement>("[data-lead-flow]");
    if (!flow || flow.dataset.ready === "true") return;
    flow.dataset.ready = "true";

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) {
      flow.classList.add("is-visible");
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        flow.classList.add("is-visible");
        observer.disconnect();
      },
      { threshold: 0.18 },
    );

    observer.observe(flow);
  };

  setupLeadFlow();
  document.addEventListener("astro:page-load", setupLeadFlow);
</script>

