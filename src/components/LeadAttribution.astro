<script>
  import { ANALYTICS_HOSTS, GA4_MEASUREMENT_ID } from "../config/site";
  import { acceptedReceipt, pendingLeadKey, sentLeadKey, readPendingLead, safeThankYouPath, thankYouPaths, type LeadParameters, type PendingLead } from "../lib/lead-receipts";
  const productionHost = ANALYTICS_HOSTS.includes(window.location.hostname);
  const consentStorageKey = "nvs-cookie-consent";
  const analyticsConsentGranted = () => {
    if (!productionHost || window.nvsTrackingExcluded) return false;
    try {
      return localStorage.getItem(consentStorageKey) === "granted";
    } catch (_) {
      return false;
    }
  };

  const track = (eventName: string, parameters: Record<string, string | number | undefined>) => {
    if (!analyticsConsentGranted()) return;
    window.dataLayer?.push({ event: eventName, ...parameters });
    window.clarity?.("event", eventName);
  };

  // A lead is pushed on the page the visitor lands on after submitting. Pushing
  // it right before the redirect lost the event in iOS Safari, because GA4 had
  // not sent its batch when the page unloaded.
  const sentInMemory = new Set<string>();
  const pushLead = (parameters: LeadParameters, callback?: () => void) => {
    if (!analyticsConsentGranted() || !window.dataLayer) return false;
    const id = String(parameters.lead_id || "");
    let sent: string[] = [];
    try {
      const saved = JSON.parse(sessionStorage.getItem(sentLeadKey) || "[]");
      if (Array.isArray(saved)) sent = saved.filter((value): value is string => typeof value === "string");
    } catch (_) {}
    if (!id || sentInMemory.has(id) || sent.includes(id)) return false;
    sentInMemory.add(id);
    try { sessionStorage.setItem(sentLeadKey, JSON.stringify([...sent, id].slice(-100))); } catch (_) {}
    // Tag Manager sends this to GA4, Google Ads and Meta (as Lead).
    window.nvsLoadTagManager?.();
    window.clarity?.("event", "generate_lead");
    detail("lead_processed", parameters);
    window.dataLayer.push({ event: "generate_lead", ...parameters, ...(callback ? { eventCallback: callback, eventTimeout: 2000 } : {}) });
    return true;
  };
  const detail = (name: string, parameters: Record<string, string | number | undefined>) => {
    if (!analyticsConsentGranted()) return;
    const qa = (() => { try { return sessionStorage.getItem("nvs-measurement-qa") === "1"; } catch (_) { return false; } })();
    window.gtag?.("event", name, { send_to: GA4_MEASUREMENT_ID, page_path: window.location.pathname, measurement_traffic: qa ? "qa" : "visitor", measurement_version: "20261108", ...(qa ? { debug_mode: true, traffic_type: "qa" } : {}), ...parameters });
    window.clarity?.("event", name);
  };
  const clearPending = (id: unknown) => {
    try {
      const saved = JSON.parse(sessionStorage.getItem(pendingLeadKey) || "null");
      if (saved?.parameters?.lead_id === id) sessionStorage.removeItem(pendingLeadKey);
    } catch (_) {}
  };
  const confirmLead = async (pending: PendingLead) => {
    for (let attempt = 0; Date.now() < pending.expiresAt; attempt++) {
      if (!analyticsConsentGranted()) return;
      if (pending.confirmed) {
        pushLead({ ...pending.parameters, crm_submission_status: "processed" });
        clearPending(pending.parameters.lead_id);
        return;
      }
      if (!pending.statusUrl) return; // Legacy CRM acceptance never becomes a guessed conversion.
      try {
        const response = await fetch(pending.statusUrl, { headers: { Accept: "application/json" }, cache: "no-store", credentials: "omit" });
        const body = await response.json();
        if (!response.ok) { if ([403, 404].includes(response.status)) { clearPending(pending.parameters.lead_id); return; } }
        else if (String(body.submission_id) === String(pending.parameters.lead_id).replace("nvs-form-", "")) {
          if (["rejected", "failed"].includes(body.status)) { clearPending(pending.parameters.lead_id); return; }
          const receipt = acceptedReceipt(body);
          if (receipt?.leadCreated) {
            pushLead({ ...pending.parameters, crm_submission_status: "processed" });
            clearPending(pending.parameters.lead_id);
            return;
          }
        }
      } catch (_) { /* A transient receipt failure must not turn into a false lead. */ }
      // The production queue may take a full minute. Keep confirming within the signed
      // receipt lifetime, with less frequent requests after the initial 30 seconds.
      const delay = Math.min(attempt < 14 ? 2000 : 10000, Math.max(0, pending.expiresAt - Date.now()));
      await new Promise(resolve => window.setTimeout(resolve, delay));
    }
    // Keep the signed pending receipt for a refresh within its short lifetime.
  };
  const flushPendingLead = () => {
    if (!thankYouPaths.includes(window.location.pathname)) return;
    let raw: string | null = null;
    try { raw = sessionStorage.getItem(pendingLeadKey); } catch (_) {}
    const receipt = readPendingLead(raw, window.location.pathname);
    if (receipt) void confirmLead(receipt);
  };

  const initialiseCrmForms = () => {
    const storageKey = "nvs-lead-attribution";
    const firstTouchStorageKey = "nvs-first-touch-attribution";
    const query = new URLSearchParams(window.location.search);
    const trackedKeys = [
      "utm_source",
      "utm_medium",
      "utm_campaign",
      "utm_content",
      "utm_term",
      "gclid",
      "gbraid",
      "wbraid",
      "fbclid",
    ];

    const readStoredObject = (storage: Storage, key: string) => {
      try {
        return JSON.parse(storage.getItem(key) || "{}") as Record<string, string>;
      } catch (_) {
        return {};
      }
    };

    let attribution: Record<string, string> = {};
    const captureSessionAttribution = () => {
      if (!analyticsConsentGranted()) return {};

      const storedAttribution = readStoredObject(sessionStorage, storageKey);
      trackedKeys.forEach((key) => {
        const value = query.get(key);
        if (value) storedAttribution[key] = value.slice(0, 300);
      });

      if (!storedAttribution.landing_page) storedAttribution.landing_page = window.location.href;
      if (!storedAttribution.initial_referrer && document.referrer) {
        storedAttribution.initial_referrer = document.referrer;
      }

      try {
        sessionStorage.setItem(storageKey, JSON.stringify(storedAttribution));
      } catch (_) {}
      return storedAttribution;
    };

    const readGaClientId = () => {
      if (!analyticsConsentGranted()) return undefined;
      const match = document.cookie.match(/(?:^|;\s*)_ga=([^;]+)/);
      if (!match) return undefined;
      const parts = decodeURIComponent(match[1]).split(".");
      const clientId = parts.length >= 4 ? `${parts[2]}.${parts[3]}` : "";
      return /^\d{1,20}\.\d{1,20}$/.test(clientId) ? clientId : undefined;
    };

    const readAnalyticsIdentity = async (): Promise<{ clientId?: string; sessionId?: string }> => {
      if (!analyticsConsentGranted()) return {};
      const identity: { clientId?: string; sessionId?: string } = { clientId: readGaClientId() };
      if (!window.gtag) return identity;
      await new Promise<void>((resolve) => {
        let completed = 0;
        const done = () => { if (++completed === 2) resolve(); };
        window.setTimeout(resolve, 800);
        try {
        window.gtag!("get", GA4_MEASUREMENT_ID, "client_id", (value: unknown) => {
          if (typeof value === "string" && /^\d{1,20}\.\d{1,20}$/.test(value)) identity.clientId = value;
          done();
        });
        window.gtag!("get", GA4_MEASUREMENT_ID, "session_id", (value: unknown) => {
          if (/^[1-9]\d{0,19}$/.test(String(value))) identity.sessionId = String(value);
          done();
        });
        } catch (_) { resolve(); }
      });
      return analyticsConsentGranted() ? identity : {};
    };

    attribution = captureSessionAttribution();

    const captureFirstTouchAttribution = () => {
      if (!analyticsConsentGranted()) return {};
      const storedAttribution = readStoredObject(localStorage, firstTouchStorageKey);
      if (storedAttribution.landing_page) return storedAttribution;

      try {
        localStorage.setItem(firstTouchStorageKey, JSON.stringify(attribution));
      } catch (_) {}
      return { ...attribution };
    };

    let firstTouchAttribution = captureFirstTouchAttribution();

    document.querySelectorAll<HTMLFormElement>("form[data-crm-form]").forEach((form, index) => {
      if (form.dataset.crmBound === "true") return;
      form.dataset.crmBound = "true";
      let startedAt: number | undefined;
      const redirectField = form.querySelector<HTMLInputElement>('input[name="redirect"]');
      const leadSource = redirectField?.value
        ? new URL(redirectField.value, window.location.origin).searchParams.get("source") || "website-form"
        : "website-form";
      const formId = form.dataset.formId || form.id || `form-${leadSource || index + 1}`;
      let formStarted = false;
      const fieldErrors = new Map<string, { at: number; category: string; count: number }>();
      let validationAttempt = 0;
      let lastValidationAt = -Infinity;
      const recordFieldError = (name: string, category: string, source = "browser") => {
        if (!analyticsConsentGranted()) return;
        const field = name.replace(/[^a-zA-Z0-9_.-]/g, "").slice(0, 80) || "unknown";
        if (["botcheck", "website", "turnstile_token"].includes(field)) return;
        const at = Date.now(), previous = fieldErrors.get(field);
        // checkValidity + reportValidity can emit the same invalid event twice.
        // Suppress only that immediate browser echo, not a later retry.
        if (previous && previous.category === category && at - previous.at < 250) return;
        if (at - lastValidationAt >= 250) validationAttempt++;
        lastValidationAt = at;
        const count = (previous?.count || 0) + 1;
        fieldErrors.set(field, { at, category, count });
        const parameters = { form_id: formId, form_location: window.location.pathname,
          field_name: field, error_type: category, validation_source: source,
          validation_attempt: validationAttempt, field_error_count: count };
        detail("form_validation", parameters);
        track("lead_form_validation_error", { ...parameters, form_type: readFormType() });
      };
      let submitting = false;
      let attemptIdentity = "";
      let attemptKey = "";

      const readFormType = () => {
        const formTypeField = form.querySelector<HTMLInputElement>('input[name="form_type"]');
        const subjectField = form.querySelector<HTMLInputElement>('input[name="subject"]');
        return formTypeField?.value || subjectField?.value || "Website enquiry";
      };

      const markFormStarted = () => {
        if (formStarted || !analyticsConsentGranted()) return;
        formStarted = true;
        startedAt = Math.floor(Date.now() / 1000);
        attribution = captureSessionAttribution();
        firstTouchAttribution = captureFirstTouchAttribution();
        detail("form_begin", { form_id: formId, form_type: readFormType(), form_location: window.location.pathname });
        track("lead_form_start", {
          form_id: formId,
          form_type: readFormType(),
          form_location: window.location.pathname,
          lead_source: leadSource,
        });
      };

      form.addEventListener("focusin", (event) => {
        const target = event.target as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
        if (!target || target.type === "hidden" || target.name === "botcheck") return;
        markFormStarted();
      });

      // Multi-step forms announce each step they open (see ContactForm).
      form.addEventListener("nvs:form-step", (event) => {
        const stepDetail = (event as CustomEvent<{ step?: number; stepName?: string }>).detail || {};
        markFormStarted();
        detail("form_step_view", { form_id: formId, step_number: stepDetail.step, step_name: stepDetail.stepName });
        track("lead_form_step", {
          form_id: formId,
          form_type: readFormType(),
          step_number: stepDetail.step,
          step_name: stepDetail.stepName,
          lead_source: leadSource,
        });
      });

      form.addEventListener("invalid", (event) => {
        const target = event.target as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
        const validity = target?.validity;
        const category = validity?.valueMissing ? "required" : validity?.typeMismatch ? "format"
          : validity?.patternMismatch ? "pattern" : validity?.tooShort || validity?.tooLong ? "length"
          : validity?.rangeUnderflow || validity?.rangeOverflow ? "range" : validity?.stepMismatch ? "step"
          : validity?.customError ? "custom" : "constraint";
        recordFieldError(target?.name || "unknown", category);
      }, true);

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (submitting) return;
        if (!productionHost) {
          let notice = form.querySelector<HTMLElement>("[data-crm-form-status]");
          if (!notice) {
            notice = document.createElement("p");
            notice.dataset.crmFormStatus = "true";
            notice.setAttribute("role", "status");
            form.appendChild(notice);
          }
          notice.textContent = "Preview only. No enquiry has been sent. Use nextvisionstudio.com to contact us.";
          return;
        }
        if (!form.reportValidity()) return;
        markFormStarted();
        submitting = true;
        detail("form_submit_attempt", { form_id: formId, form_type: readFormType(), form_location: window.location.pathname });

        const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const status = document.createElement("p");
        status.setAttribute("role", "status");
        status.setAttribute("aria-live", "polite");
        status.dataset.crmFormStatus = "true";
        form.querySelector("[data-crm-form-status]")?.remove();
        submit?.insertAdjacentElement("afterend", status);
        if (submit) submit.disabled = true;

        const values = new FormData(form);
        const read = (key: string) => String(values.get(key) || "").trim();
        const excluded = new Set([
          "name", "email", "phone", "company", "business", "business_name",
          "service", "message", "value", "redirect", "subject", "from_name",
          "form_type", "landing_page", "botcheck", "website",
        ]);
        const extraDetails: string[] = [];
        for (const [key, value] of values.entries()) {
          if (excluded.has(key) || !String(value).trim()) continue;
          const label = key.replaceAll("_", " ").replace(/\b\w/g, (character) => character.toUpperCase());
          extraDetails.push(`${label}: ${String(value).trim()}`);
        }

        const formType = read("form_type") || read("subject");
        const serviceInterest = read("service") || formType || "Website enquiry";
        const formDurationSeconds = Math.min(86400, Math.max(0, Math.floor(Date.now() / 1000) - (startedAt || Math.floor(Date.now() / 1000))));
        const messageParts = [read("message")];
        if (extraDetails.length) messageParts.push(extraDetails.join("\n"));
        const analyticsIdentity = await readAnalyticsIdentity();
        const payload: Record<string, unknown> = {
          name: read("name"),
          email: read("email") || undefined,
          phone: read("phone") || undefined,
          company: read("company") || read("business") || read("business_name") || undefined,
          service: read("service") || formType || "Website enquiry",
          message: messageParts.filter(Boolean).join("\n\n") || undefined,
          value: read("value") ? Number(read("value")) : undefined,
          consent: true,
          analytics_consent: analyticsConsentGranted(),
          ad_user_data_consent: analyticsConsentGranted(),
          ga_client_id: analyticsIdentity.clientId,
          ga_session_id: analyticsIdentity.sessionId,
          website: read("botcheck") || read("website"),
          form_started_at: startedAt || Math.floor(Date.now() / 1000),
          form_duration_seconds: formDurationSeconds,
          form_id: formId,
          form_type: formType || "Website enquiry",
          form_source: leadSource,
          form_page: window.location.origin + window.location.pathname,
          landing_page: attribution.landing_page || window.location.origin + window.location.pathname,
          referrer: attribution.initial_referrer || undefined,
          measurement_traffic: (() => { try { return sessionStorage.getItem("nvs-measurement-qa") === "1" ? "qa" : "visitor"; } catch (_) { return "visitor"; } })(),
        };

        trackedKeys.forEach((key) => {
          if (attribution[key]) payload[key] = attribution[key];
        });

        if (firstTouchAttribution.landing_page) {
          payload.first_touch_landing_page = firstTouchAttribution.landing_page;
          payload.first_touch_referrer = firstTouchAttribution.initial_referrer || undefined;
          ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"].forEach((key) => {
            if (firstTouchAttribution[key]) payload[`first_touch_${key}`] = firstTouchAttribution[key];
          });
        }

        // A network retry of the same enquiry must reuse its CRM key.
        const identity = JSON.stringify({ ...payload, form_started_at: 0, form_duration_seconds: 0 });
        if (identity !== attemptIdentity) {
          attemptIdentity = identity;
          attemptKey = crypto.randomUUID?.() || `${Date.now()}-${Math.random()}`;
        }
        try {
          const response = await fetch(form.action, {
            method: "POST",
            headers: {
              Accept: "application/json",
              "Content-Type": "application/json",
              "Idempotency-Key": attemptKey,
            },
            body: JSON.stringify(payload),
          });
          const body = await response.json().catch(() => ({}));
          if (!response.ok) {
            if (response.status === 422 && body.errors && typeof body.errors === "object") {
              for (const field of Object.keys(body.errors).slice(0, 20)) {
                // Only configured, visible form fields; never send server messages or values.
                if (/^[a-zA-Z0-9_-]{1,80}$/.test(field) && form.querySelector(`[name="${field}"]`)) {
                  recordFieldError(field, "server_validation", "server");
                }
              }
            }
            detail("form_submission_error", { form_id: formId, error_type: response.status === 422 ? "validation" : "http", http_status: response.status });
            const errors = Object.values(body.errors || {}).flat();
            throw new Error(String(errors[0] || body.message || "The form could not be submitted."));
          }
          const receipt = acceptedReceipt(body);
          if (!receipt) throw new Error("We could not confirm your enquiry. Please try again or contact us directly.");

          status.textContent = "Thank you. Your enquiry has been received.";
          const redirect = read("redirect");
          // Record the persisted CRM submission, not a button click or page visit.
          const leadParameters = {
            lead_id: receipt.id,
            transaction_id: receipt.id,
            crm_submission_status: receipt.status,
            lead_source: leadSource,
            form_type: formType || "Website enquiry",
            form_id: formId,
            form_location: window.location.pathname,
            service_interest: serviceInterest,
            form_duration_seconds: formDurationSeconds,
          };

          detail("form_submission_received", { form_id: formId, form_location: window.location.pathname, crm_submission_status: receipt.status });
          const pending: PendingLead = {
            version: 2,
            destination: safeThankYouPath(redirect, window.location.origin) || "/quotesend/",
            expiresAt: Date.now() + 15 * 60 * 1000,
            parameters: leadParameters,
            statusUrl: receipt.statusUrl,
            confirmed: receipt.leadCreated,
          };
          if (!redirect) {
            void confirmLead(pending);
            form.reset(); attemptIdentity = ""; attemptKey = ""; submitting = false;
            if (submit) submit.disabled = false;
            return;
          }
          let deferred = false;
          try {
            if (analyticsConsentGranted() && safeThankYouPath(redirect, window.location.origin)) {
              sessionStorage.setItem(pendingLeadKey, JSON.stringify(pending));
              deferred = true;
            }
          } catch (_) {}
          if (!deferred && analyticsConsentGranted()) void confirmLead(pending);
          window.location.assign(redirect);
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : "The form could not be submitted.";
          track("lead_form_error", {
            form_id: formId,
            form_type: formType || "Website enquiry",
            error_type: "crm_submission_failed",
          });
          if (submit) submit.disabled = false;
          submitting = false;
        }
      });
    });
  };

  flushPendingLead();
  if (!analyticsConsentGranted()) {
    try {
      sessionStorage.removeItem(pendingLeadKey);
      sessionStorage.removeItem("nvs-lead-attribution");
      localStorage.removeItem("nvs-first-touch-attribution");
    } catch (_) {}
  }
  initialiseCrmForms();
  document.addEventListener("astro:page-load", initialiseCrmForms);

  document.addEventListener("click", (event) => {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>("a[href]");
    if (!link) return;

    const href = link.href;
    const ctaPlacement = link.dataset.ctaPlacement;

    if (ctaPlacement) {
      track("cta_click", {
        cta_placement: ctaPlacement,
        link_text: link.textContent?.trim().slice(0, 120) || "",
        link_url: href,
      });
    }

    if (href.startsWith("tel:")) {
      detail("contact_intent", { contact_method: "phone", form_location: window.location.pathname });
      track("click_call", { link_url: href });
    }
    if (href.includes("wa.me")) {
      detail("contact_intent", { contact_method: "whatsapp", form_location: window.location.pathname });
      track("click_whatsapp", { link_url: href });
    }
  });
</script>
