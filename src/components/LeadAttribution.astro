<script>
  const consentStorageKey = "nvs-cookie-consent";
  const analyticsConsentGranted = () => {
    try {
      return localStorage.getItem(consentStorageKey) === "granted";
    } catch (_) {
      return false;
    }
  };

  const track = (eventName: string, parameters: Record<string, string | number | undefined>) => {
    if (!analyticsConsentGranted()) return;
    window.gtag?.("event", eventName, parameters);
  };

  const initialiseCrmForms = () => {
    const storageKey = "nvs-lead-attribution";
    const firstTouchStorageKey = "nvs-first-touch-attribution";
    const query = new URLSearchParams(window.location.search);
    const trackedKeys = [
      "utm_source",
      "utm_medium",
      "utm_campaign",
      "utm_content",
      "utm_term",
      "gclid",
      "gbraid",
      "wbraid",
      "fbclid",
    ];

    const readStoredObject = (storage: Storage, key: string) => {
      try {
        return JSON.parse(storage.getItem(key) || "{}") as Record<string, string>;
      } catch (_) {
        return {};
      }
    };

    let attribution: Record<string, string> = {};
    const captureSessionAttribution = () => {
      if (!analyticsConsentGranted()) return {};

      const storedAttribution = readStoredObject(sessionStorage, storageKey);
      trackedKeys.forEach((key) => {
        const value = query.get(key);
        if (value) storedAttribution[key] = value.slice(0, 300);
      });

      if (!storedAttribution.landing_page) storedAttribution.landing_page = window.location.href;
      if (!storedAttribution.initial_referrer && document.referrer) {
        storedAttribution.initial_referrer = document.referrer;
      }

      try {
        sessionStorage.setItem(storageKey, JSON.stringify(storedAttribution));
      } catch (_) {}
      return storedAttribution;
    };

    const readGaClientId = () => {
      if (!analyticsConsentGranted()) return undefined;
      const match = document.cookie.match(/(?:^|;\s*)_ga=([^;]+)/);
      if (!match) return undefined;
      const parts = decodeURIComponent(match[1]).split(".");
      const clientId = parts.length >= 4 ? `${parts[2]}.${parts[3]}` : "";
      return /^\d{1,20}\.\d{1,20}$/.test(clientId) ? clientId : undefined;
    };

    attribution = captureSessionAttribution();

    const captureFirstTouchAttribution = () => {
      if (!analyticsConsentGranted()) return {};
      const storedAttribution = readStoredObject(localStorage, firstTouchStorageKey);
      if (storedAttribution.landing_page) return storedAttribution;

      try {
        localStorage.setItem(firstTouchStorageKey, JSON.stringify(attribution));
      } catch (_) {}
      return { ...attribution };
    };

    let firstTouchAttribution = captureFirstTouchAttribution();

    document.querySelectorAll<HTMLFormElement>("form[data-crm-form]").forEach((form, index) => {
      if (form.dataset.crmBound === "true") return;
      form.dataset.crmBound = "true";
      let startedAt: number | undefined;
      const redirectField = form.querySelector<HTMLInputElement>('input[name="redirect"]');
      const leadSource = redirectField?.value
        ? new URL(redirectField.value, window.location.origin).searchParams.get("source") || "website-form"
        : "website-form";
      const formId = form.dataset.formId || form.id || `form-${leadSource || index + 1}`;
      let formStarted = false;
      let validationErrorTracked = false;

      const readFormType = () => {
        const formTypeField = form.querySelector<HTMLInputElement>('input[name="form_type"]');
        const subjectField = form.querySelector<HTMLInputElement>('input[name="subject"]');
        return formTypeField?.value || subjectField?.value || "Website enquiry";
      };

      const markFormStarted = () => {
        if (formStarted) return;
        formStarted = true;
        startedAt = Math.floor(Date.now() / 1000);
        attribution = captureSessionAttribution();
        firstTouchAttribution = captureFirstTouchAttribution();
        track("lead_form_start", {
          form_id: formId,
          form_type: readFormType(),
          form_location: window.location.pathname,
          lead_source: leadSource,
        });
      };

      form.addEventListener("focusin", (event) => {
        const target = event.target as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
        if (!target || target.type === "hidden" || target.name === "botcheck") return;
        markFormStarted();
      });

      form.addEventListener("invalid", (event) => {
        if (validationErrorTracked) return;
        validationErrorTracked = true;
        const target = event.target as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
        track("lead_form_validation_error", {
          form_id: formId,
          form_type: readFormType(),
          field_type: target?.type || target?.tagName.toLowerCase() || "unknown",
        });
      }, true);

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        markFormStarted();

        const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const status = document.createElement("p");
        status.setAttribute("role", "status");
        status.setAttribute("aria-live", "polite");
        status.dataset.crmFormStatus = "true";
        form.querySelector("[data-crm-form-status]")?.remove();
        submit?.insertAdjacentElement("afterend", status);
        if (submit) submit.disabled = true;

        const values = new FormData(form);
        const read = (key: string) => String(values.get(key) || "").trim();
        const excluded = new Set([
          "name", "email", "phone", "company", "business", "business_name",
          "service", "message", "value", "redirect", "subject", "from_name",
          "form_type", "landing_page", "botcheck", "website",
        ]);
        const extraDetails: string[] = [];
        for (const [key, value] of values.entries()) {
          if (excluded.has(key) || !String(value).trim()) continue;
          const label = key.replaceAll("_", " ").replace(/\b\w/g, (character) => character.toUpperCase());
          extraDetails.push(`${label}: ${String(value).trim()}`);
        }

        const formType = read("form_type") || read("subject");
        const serviceInterest = read("service") || formType || "Website enquiry";
        const formDurationSeconds = Math.max(0, Math.floor(Date.now() / 1000) - (startedAt || Math.floor(Date.now() / 1000)));
        const messageParts = [read("message")];
        if (extraDetails.length) messageParts.push(extraDetails.join("\n"));
        const payload: Record<string, unknown> = {
          name: read("name"),
          email: read("email") || undefined,
          phone: read("phone") || undefined,
          company: read("company") || read("business") || read("business_name") || undefined,
          service: read("service") || formType || "Website enquiry",
          message: messageParts.filter(Boolean).join("\n\n") || undefined,
          value: read("value") ? Number(read("value")) : undefined,
          consent: true,
          analytics_consent: analyticsConsentGranted(),
          ad_user_data_consent: analyticsConsentGranted(),
          ga_client_id: readGaClientId(),
          website: read("botcheck") || read("website"),
          form_started_at: startedAt || Math.floor(Date.now() / 1000),
          form_duration_seconds: formDurationSeconds,
          form_id: formId,
          form_type: formType || "Website enquiry",
          form_source: leadSource,
          form_page: window.location.href,
          landing_page: attribution.landing_page || window.location.href,
          initial_referrer: attribution.initial_referrer || undefined,
        };

        trackedKeys.forEach((key) => {
          if (attribution[key]) payload[key] = attribution[key];
        });

        if (firstTouchAttribution.landing_page) {
          payload.first_touch_landing_page = firstTouchAttribution.landing_page;
          payload.first_touch_referrer = firstTouchAttribution.initial_referrer || undefined;
          ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"].forEach((key) => {
            if (firstTouchAttribution[key]) payload[`first_touch_${key}`] = firstTouchAttribution[key];
          });
        }

        try {
          const response = await fetch(form.action, {
            method: "POST",
            headers: {
              Accept: "application/json",
              "Content-Type": "application/json",
              "Idempotency-Key": crypto.randomUUID?.() || `${Date.now()}-${Math.random()}`,
            },
            body: JSON.stringify(payload),
          });
          const body = await response.json().catch(() => ({}));
          if (!response.ok) {
            const errors = Object.values(body.errors || {}).flat();
            throw new Error(String(errors[0] || body.message || "The form could not be submitted."));
          }

          status.textContent = "Thank you. Your enquiry has been received.";
          const redirect = read("redirect");
          let finished = false;
          const finish = () => {
            if (finished) return;
            finished = true;
            if (redirect) {
              window.location.assign(redirect);
            } else {
              form.reset();
              if (submit) submit.disabled = false;
            }
          };

          // Count a lead only after the CRM accepts it, then allow the tag to send
          // the event before leaving the page. The fallback handles blocked tags.
          if (analyticsConsentGranted()) {
            window.nvsLoadGoogleTag?.();
            window.gtag?.("event", "generate_lead", {
              lead_source: leadSource,
              form_type: formType || "Website enquiry",
              form_id: formId,
              form_location: window.location.pathname,
              service_interest: serviceInterest,
              form_duration_seconds: formDurationSeconds,
              event_callback: finish,
              event_timeout: 1500,
            });
            window.setTimeout(finish, 1700);
          } else {
            finish();
          }
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : "The form could not be submitted.";
          track("lead_form_error", {
            form_id: formId,
            form_type: formType || "Website enquiry",
            error_type: "crm_submission_failed",
          });
          if (submit) submit.disabled = false;
        }
      });
    });
  };

  initialiseCrmForms();
  document.addEventListener("astro:page-load", initialiseCrmForms);

  document.addEventListener("click", (event) => {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>("a[href]");
    if (!link) return;

    const href = link.href;
    const ctaPlacement = link.dataset.ctaPlacement;

    if (ctaPlacement) {
      track("cta_click", {
        cta_placement: ctaPlacement,
        link_text: link.textContent?.trim().slice(0, 120) || "",
        link_url: href,
      });
    }

    if (href.startsWith("tel:")) {
      track("click_call", { link_url: href });
    }
    if (href.includes("wa.me")) {
      track("click_whatsapp", { link_url: href });
    }
  });
</script>
