---
const services = [
  {
    key: "shortform",
    href: "/short-form-video-production-dublin/",
    title: "Full Service Short Form Content Production",
    introduction: "Turn one filming day into a library of videos that keeps your business visible across social media.",
    benefits: [
      "Plan ideas for the people you want to reach.",
      "Film several videos in one visit.",
      "Get edits ready for Instagram, TikTok and YouTube.",
    ],
  },
  {
    key: "video",
    href: "/videography-dublin/",
    title: "Commercial and Brand Film Production",
    introduction: "Show people what makes your business worth choosing with a polished film built around your story.",
    benefits: [
      "Find the clearest story for your business.",
      "Film your people, product or service.",
      "Use your finished film on your website and campaigns.",
    ],
  },
  {
    key: "social",
    href: "/social-media-content-creation-dublin/",
    title: "Social Media Content and Management",
    introduction: "Keep your social pages useful and consistent with planned content made for your business.",
    benefits: [
      "Plan posts around your offers and audience.",
      "Create videos, photos and captions in batches.",
      "Keep your pages active with content ready to publish.",
    ],
  },
  {
    key: "photography",
    href: "/photography-dublin/",
    title: "Professional Photography",
    introduction: "Give your brand a clear, consistent look with photos made for your website and social media.",
    benefits: [
      "Show your products, people and place.",
      "Build a useful library of images.",
      "Receive edited photos ready to use.",
    ],
  },
  {
    key: "web",
    href: "/webdesigner-dublin/",
    title: "Website Design and Development",
    introduction: "Make it easy for people to understand what you offer and take the next step.",
    benefits: [
      "A clear layout for phones and computers.",
      "Simple pages that answer customer questions.",
      "Easy ways for visitors to contact you.",
    ],
  },
  {
    key: "crm",
    href: "/crm-lead-automation-dublin/",
    title: "CRM and AI Automation",
    introduction: "Spend less time on repeat tasks and make it easier to respond to every new enquiry.",
    benefits: [
      "Keep contacts and enquiries organised.",
      "Send quick, helpful follow up messages.",
      "Let AI handle simple routine tasks.",
    ],
  },
];
---

<section class="services" id="services" aria-labelledby="services-title">
  <div class="services__inner">
    <header class="services__header">
      <h2 id="services-title">Our Services, Made to a Higher Standard</h2>
      <div class="services__intro">
        <p>
          In a crowded market, quality content is a real advantage. Useful video,
          photography and campaigns help people understand your business and trust
          what you offer.
        </p>
        <p>
          We make videos, photos, websites and ads that help your business get noticed,
          earn trust and bring in enquiries. Every project starts with a clear goal.
        </p>
      </div>
    </header>

    <div class="services__grid">
      {services.map((service, index) => (
        <a
          class:list={["service-card", `service-card--${service.key}`]}
          href={service.href}
          aria-label={`${service.title}. Learn more`}
          data-cta-placement={`service-${service.key}`}
        >
          <div class="service-card__copy">
            <div class="service-card__counter" aria-label={`Service ${index + 1} of ${services.length}`}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <span aria-hidden="true">/ 06</span>
            </div>
            <h3>{service.title}</h3>
            <p>{service.introduction}</p>
            <ul>
              {service.benefits.map((benefit) => <li>{benefit}</li>)}
            </ul>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .services,
  .services * {
    box-sizing: border-box;
  }

  .services {
    position: relative;
    width: 100%;
    margin: 0;
    padding: 96px 24px 100px;
    overflow: hidden;

    background: #111111;
    color: #ffffff;
  }

  .services__inner {
    position: relative;
    width: min(100%, 1440px);
    margin: 0 auto;
  }

  .services__header {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: end;
    gap: 54px;
    width: 100%;
    margin: 0 auto 48px;
    text-align: left;
  }

  .services__header h2 {
    margin: 0;
    color: #ffffff;
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .services__intro p {
    margin: 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: clamp(16px, 1.4vw, 18px);
    font-weight: 550;
    line-height: 1.62;
  }

  .services__intro p + p {
    margin-top: 14px;
    color: rgba(255, 255, 255, 0.52);
  }

  .services__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .service-card {
    --card-accent: 155, 210, 255;
    --card-image: url("/images/home-services/video-production-bg.webp");

    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
    min-height: 500px;
    padding: 54px 7%;
    overflow: hidden;

    border: 1px solid rgba(var(--card-accent), 0.3);
    border-radius: 32px;
    outline: none;
    background: #111;
    color: inherit;
    text-decoration: none;
    cursor: pointer;

    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.045),
      0 28px 70px rgba(0, 0, 0, 0.26);

    transition: border-color 360ms ease, box-shadow 360ms ease;
  }

  .service-card::before,
  .service-card::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .service-card::before {
    z-index: -2;
    background-image: var(--card-image);
    background-position: center;
    background-size: cover;
    inset: 0;
    filter: brightness(0.78);
    opacity: 0.72;
    transition: opacity 360ms ease, transform 360ms ease;
  }

  .service-card::after {
    z-index: -1;
    background: linear-gradient(90deg, rgba(8, 10, 13, 0.38) 0%, rgba(8, 10, 13, 0.56) 36%, rgba(17, 17, 17, 0.86) 64%, rgba(17, 17, 17, 0.94) 100%);
    opacity: 1;
    transition: background 360ms ease;
  }

  .service-card--video {
    --card-image: url("/images/home-services/video-production-bg.webp");
  }

  .service-card--shortform {
    --card-image: url("/images/home-services/social-content-bg.webp");
    --card-accent: 130, 180, 220;
  }

  .service-card--social {
    --card-image: url("/images/home-services/google-meta-ads-bg.webp");
    --card-accent: 130, 180, 220;
  }

  .service-card--photography {
    --card-image: url("/images/photography/brand-photography-social-content-dublin.webp");
    --card-accent: 190, 225, 255;
  }

  .service-card--web {
    --card-image: url("/images/home-services/website-design-bg.webp");
    --card-accent: 190, 225, 255;
  }

  .service-card--crm {
    --card-image: url("/images/home-services/crm-lead-bg.webp");
    --card-accent: 130, 180, 220;
  }

  .service-card:hover,
  .service-card:focus-visible {
    border-color: rgba(var(--card-accent), 0.7);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.09),
      0 0 42px rgba(var(--card-accent), 0.1),
      0 36px 86px rgba(0, 0, 0, 0.38);
    transform: translateY(-5px);
  }

  .service-card:hover::before,
  .service-card:focus-visible::before {
    opacity: 1;
    transform: scale(1.025);
  }

  .service-card__copy {
    position: relative;
    width: min(100%, 620px);
    margin-left: auto;
  }

  .service-card__counter {
    display: flex;
    align-items: baseline;
    gap: 8px;
    width: fit-content;
    margin: 0 0 24px;
    padding-bottom: 13px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
    font-size: 20px;
    font-weight: 650;
    letter-spacing: 0.08em;
  }

  .service-card__counter span:last-child {
    color: rgba(255, 255, 255, 0.58);
    font-size: 13px;
    font-weight: 500;
  }

  .service-card h3 {
    margin: 0 0 16px;
    color: #ffffff;
    font-size: clamp(32px, 3.1vw, 46px);
    font-weight: 850;
    line-height: 1.04;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .service-card:focus-visible {
    outline: 2px solid #cfeaff;
    outline-offset: 4px;
  }

  .service-card p {
    margin: 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: clamp(16px, 1.35vw, 19px);
    font-weight: 500;
    line-height: 1.55;
  }

  .service-card ul {
    display: grid;
    gap: 13px;
    margin: 22px 0 26px;
    padding: 0;
    list-style: none;
  }

  .service-card li {
    position: relative;
    padding-left: 28px;
    color: rgba(255, 255, 255, 0.8);
    font-size: 15px;
    line-height: 1.45;
  }

  .service-card li::before {
    position: absolute;
    top: 0;
    left: 0;
    color: #b9efc5;
    content: "✓";
    font-size: 17px;
    font-weight: 800;
  }

  @media (max-width: 980px) {
    .services__header {
      grid-template-columns: 1fr;
      gap: 24px;
      width: min(100%, 680px);
      margin-bottom: 38px;
    }

    .services__grid {
      grid-template-columns: 1fr;
      width: min(100%, 680px);
      margin: 0 auto;
    }

    .service-card { min-height: 470px; padding: 40px 6%; }
    .service-card__copy { width: min(100%, 560px); }
  }

  @media (max-width: 640px) {
    .services {
      padding: 92px 16px 82px;
    }

    .services__header {
      margin-bottom: 34px;
    }

    .services__header h2 {
      font-size: clamp(39px, 12vw, 54px);
    }

    .services__intro p {
      font-size: 16px;
      line-height: 1.55;
    }

    .service-card {
      min-height: 0;
      padding: 260px 26px 30px;
      border-radius: 24px;
    }

    .service-card::before { inset: 0; }
    .service-card::after {
      background: linear-gradient(180deg, rgba(8, 10, 13, 0.05) 0%, rgba(17, 17, 17, 0.7) 42%, #111111 56%, #111111 100%);
    }
    .service-card__copy { width: 100%; }
    .service-card__counter { margin-bottom: 18px; }
    .service-card h3 {
      font-size: clamp(27px, 8vw, 34px);
    }
    .service-card ul { gap: 10px; margin: 18px 0 22px; }
    .service-card li { font-size: 14px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card,
    .service-card::before,
    .service-card::after {
      transition: none;
    }
  }
</style>
