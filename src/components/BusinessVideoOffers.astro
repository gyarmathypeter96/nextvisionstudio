---
import { businessVideoOffers } from "../data/businessVideoOffers";
---

<section class="video-offers" id="video-offers" aria-labelledby="video-offers-title">
  <header>

    <h2 id="video-offers-title">A content day or a business film?</h2>
    <p>Start with where the videos will be used. We help choose the right filming plan and confirm the finished work before you book.</p>
  </header>
  <div class="video-offers__grid">
    {businessVideoOffers.map((offer) => <article id={offer.id}>
      <span class="video-offers__label">{offer.label}</span>
      <h3>{offer.title}</h3>
      <p>{offer.text}</p>
      <ul>{offer.items.map((item) => <li>{item}</li>)}</ul>
      <a class="video-offers__cta" href="#landing-contact" data-cta-placement={`video-offer-${offer.id}`}>Plan my {offer.title === "Content Day" ? "content day" : "business video"}</a>
      <a class="video-offers__detail" href={offer.link}>{offer.linkLabel}</a>
    </article>)}
  </div>
  <p class="video-offers__scope">Your proposal confirms filming time, locations, video count and lengths, delivery dates, usage and included changes. Photography, publishing, account management and advertising are added only when agreed. Prices depend on that scope.</p>
  <a class="video-offers__guide" href="/blog/content-day-or-business-video/">Which option fits your project?</a>
</section>

<style>
  .video-offers, .video-offers * { box-sizing: border-box; }
  .video-offers { width: min(100% - 48px, 1180px); margin: 0 auto; padding: 72px 0 24px; color: #fff; scroll-margin-top: 110px; }
  header { max-width: 850px; margin-bottom: 30px; }
  .video-offers__label { color: #cfeaff; font-size: 11px; font-weight: 800; }
  h2 { margin: 16px 0 20px; font-size: clamp(34px, 4.3vw, 54px); line-height: 1.06; text-wrap: balance; }
  p, li { color: rgba(255,255,255,.74); font-size: 17px; line-height: 1.65; }
  .video-offers__grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 22px; }
  article { display: flex; flex-direction: column; min-width: 0; padding: clamp(24px,4vw,38px); border: 1px solid rgba(180,220,255,.23); border-radius: 26px; background: radial-gradient(ellipse at 100% 0,rgba(155,210,255,.1),transparent 70%),#171b1f; }
  h3 { margin: 12px 0 0; font-size: clamp(30px,3.5vw,42px); line-height: 1.1; }
  article p { margin: 20px 0; }
  ul { padding: 0 0 0 20px; margin: 0 0 30px; }
  li + li { margin-top: 10px; }
  a { color: #cfeaff; text-underline-offset: 5px; }
  .video-offers__cta { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; margin-top: auto; padding: 14px 22px; border: 1px solid rgba(207,234,255,.4); border-radius: 999px; background: linear-gradient(135deg,rgba(207,234,255,.18),rgba(207,234,255,.06)); box-shadow: inset 0 1px 0 rgba(255,255,255,.12); color: #fff; font-weight: 800; text-decoration: none; }
  .video-offers__cta:hover { background: rgba(207,234,255,.2); }
  .video-offers__detail { align-self: center; margin-top: 18px; font-size: 14px; line-height: 1.6; }
  .video-offers__scope { max-width: 960px; margin: 26px 0 12px; font-size: 14px; }
  .video-offers__guide { display: inline-block; padding: 10px 0; font-size: 15px; font-weight: 750; }
  a:focus-visible { outline: 2px solid #cfeaff; outline-offset: 5px; }
  @media (max-width: 760px) { .video-offers { width: calc(100% - 32px); padding-top: 48px; } .video-offers__grid { grid-template-columns: 1fr; } article { padding: 26px; } p, li { font-size: 16px; } }
</style>
