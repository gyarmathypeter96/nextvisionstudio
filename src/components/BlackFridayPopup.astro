---
import { CRM_FORM_ENDPOINT } from '../config/forms';
const promotionActive = new Date() < new Date('2026-12-01T00:00:00Z');
const enabled = promotionActive && ['/', '/social-media-content-creation-dublin/', '/how-much-does-a-videographer-cost-in-dublin/', '/corporate-video-production-dublin/'].includes(Astro.url.pathname);
---
{enabled && <>
<button class="bf-launch" type="button" data-bf-open>Black Friday gift</button>
<dialog class="bf-dialog" id="black-friday-deal" aria-labelledby="bf-title" aria-describedby="bf-description">
  <button class="bf-close" type="button" aria-label="Close Black Friday offer">×</button>
  <svg class="bf-gift" viewBox="0 0 100 100" fill="none" aria-hidden="true"><path d="M15 40h70v16H15zM23 56h54v34H23zM50 40v50M50 40C15 40 22 8 40 20L50 40ZM50 40C85 40 78 8 60 20L50 40Z" /></svg>
  <p class="bf-label">BLACK FRIDAY DEAL</p><h2 id="bf-title">8 videos. 8 bonus photos. €100 off.</h2>
  <p id="bf-description">Full Monthly Content: <strong>8 short-form videos: <del>€550</del> <span class="bf-price">€450 / month</span></strong> Includes content planning and a half-day shoot at your business.</p>
  <p class="bf-bonus">Plus 8 edited on-location photographs as your Black Friday bonus. Offer valid until 30 November 2026.</p>
  <p>Content production only. Posting, account management and paid ads are separate. Leave your details to ask about the offer.</p>
  <form action={CRM_FORM_ENDPOINT} method="POST" id="black-friday-popup-form" data-crm-form data-form-id="black-friday-popup">
    <input type="hidden" name="redirect" value="https://www.nextvisionstudio.com/quotesend/?submitted=1&source=black-friday-popup" />
    <input type="hidden" name="subject" value="Black Friday popup enquiry" />
    <input type="hidden" name="form_type" value="Black Friday popup" />
    <input type="hidden" name="service" value="Black Friday popup - Full Monthly Content" />
    <input type="hidden" name="message" value="Black Friday popup lead: Full Monthly Content, regular EUR 550, Black Friday EUR 450/month, 8 short videos plus 8 edited on-location photographs. Offer valid until 30 November 2026. Production only; publishing and account management separate." />
    <input type="hidden" name="content_package" value="Full Monthly Content — Black Friday EUR 450" />
    <div hidden aria-hidden="true"><input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></div>
    <label for="bf-name">Name</label><input id="bf-name" name="name" autocomplete="name" required />
    <label for="bf-phone">Phone</label><input id="bf-phone" name="phone" type="tel" autocomplete="tel" required />
    <label for="bf-email">Email</label><input id="bf-email" name="email" type="email" autocomplete="email" required />
    <button type="submit">Ask about the Black Friday deal</button>
    <p class="bf-privacy">No obligation. We use your details to respond to this enquiry. <a href="/privacy-policy/">Privacy policy</a></p>
    <p data-bf-status role="status" aria-live="polite"></p>
  </form>
</dialog>
</>}
<script>
const dialog = document.querySelector<HTMLDialogElement>('#black-friday-deal');
if(new Date() >= new Date('2026-12-01T00:00:00Z')) document.querySelector<HTMLElement>('[data-bf-open]')?.setAttribute('hidden','');
if(dialog && new Date() < new Date("2026-12-01T00:00:00Z")){
 const key='nvs-black-friday-dismissed';
 let dismissed=false;
 try { dismissed=sessionStorage.getItem(key)==='true'; } catch {}
 const open=()=>{if(!dialog.open)dialog.showModal();};
 const remember=()=>{dismissed=true;try{sessionStorage.setItem(key,'true');}catch{}};
 document.querySelector('[data-bf-open]')?.addEventListener('click',open);
 dialog.querySelector('.bf-close')?.addEventListener('click',()=>dialog.close());
 dialog.addEventListener('close',remember);
 dialog.addEventListener('click',event=>{if(event.target===dialog){const r=dialog.getBoundingClientRect();const e=event as MouseEvent;if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close();}});
 window.addEventListener('scroll',()=>{if(!dismissed&&!dialog.open&&window.scrollY>window.innerHeight&&window.scrollY/(document.documentElement.scrollHeight-innerHeight)>.35&&!document.activeElement?.closest('form'))open();},{passive:true});
 // Local preview exercises validation and the form without creating a real CRM lead.
 dialog.querySelector('form')?.addEventListener('submit',event=>{
 if(['localhost','127.0.0.1'].includes(location.hostname)){event.preventDefault();event.stopImmediatePropagation();const status=dialog.querySelector('[data-bf-status]');if(status)status.textContent='Preview checked: Black Friday popup lead. Nothing was sent.';}
 },true);
}
</script>
<style>
.bf-launch[hidden] {display:none;}

.bf-label {font-weight:850!important;letter-spacing:.12em;color:#f1df86!important;}
.bf-price {display:block;font-size:32px;color:#f1df86;}
.bf-dialog del {color:#bbc2c8;text-decoration-thickness:2px;}
.bf-dialog {background:#111!important;border-color:#e6d47b!important;}
.bf-dialog .bf-bonus {background:#292615;border:1px solid #e6d47b66;}
.bf-gift {stroke:#f1df86!important;}
.bf-launch,.bf-dialog button[type=submit] {background:#f1df86!important;color:#15130a!important;}

.bf-launch {position:fixed;bottom:24px;left:20px;z-index:80;min-height:44px;border:1px solid #cfeaff;border-radius:24px;padding:12px 18px;background:#cfeaff;color:#111c25;font:inherit;font-size:14px;font-weight:700;cursor:pointer;}
.bf-dialog {box-sizing:border-box;width:min(540px,calc(100% - 32px));max-height:calc(100dvh - 32px);overflow:auto;padding:32px;border:1px solid #7894aa;border-radius:24px;background:#151e27;color:#f5f8fa;box-shadow:0 28px 90px #0008;}
.bf-dialog::backdrop {background:#000b;}
.bf-close {position:absolute;right:14px;top:10px;width:44px;height:44px;border:0;background:none;color:#fff;font-size:30px;cursor:pointer;}
.bf-gift {width:64px;height:64px;stroke:#cfeaff;stroke-width:3;}
h2 {font-size:30px;line-height:1.15;margin:15px 0;letter-spacing:-.025em;}
p {font-size:14px;line-height:1.6;color:#c6d0d9;}
.bf-bonus {padding:14px;border-radius:12px;background:#263b4c;color:#fff;font-weight:650;}
label {display:block;font-size:14px;margin:14px 0 6px;}
input:not([type=hidden]):not([type=checkbox]) {box-sizing:border-box;width:100%;min-height:46px;padding:10px 12px;background:#0f161d;color:#fff;border:1px solid #71818f;border-radius:8px;font:inherit;}
button[type=submit] {width:100%;min-height:48px;margin-top:20px;padding:12px;border:0;border-radius:24px;background:#cfeaff;color:#111c25;font:inherit;font-weight:700;cursor:pointer;}
.bf-privacy {font-size:12px;}a {color:#cfeaff;}button:focus-visible,input:focus-visible {outline:2px solid #fff;outline-offset:3px;}
@media(max-width:600px){.bf-dialog{padding:25px 20px;}h2{font-size:26px;}.bf-launch{bottom:20px;left:12px;font-size:12px;padding:10px 14px;}}
</style>
