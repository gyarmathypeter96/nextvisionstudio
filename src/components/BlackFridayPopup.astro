---
import { CRM_FORM_ENDPOINT } from '../config/forms';
const promotionActive = new Date() < new Date('2026-12-01T00:00:00Z');
---
{promotionActive && <>
  <button class="bf-launch" type="button" data-bf-open aria-label="Open the Black Friday offer">Black Friday offer</button>
  <dialog class="bf-dialog" id="black-friday-deal" aria-labelledby="bf-title">
    <button class="bf-close" type="button" aria-label="Close Black Friday offer">×</button>
    <p class="bf-label">BLACK FRIDAY · ENDS 30 NOVEMBER</p>
    <h2 id="bf-title">8 Reels + 8 Photos</h2>
    <p class="bf-price-line"><del>€550</del><span><small>NOW</small><strong>€450</strong><em>/ month</em></span></p>
    <form action={CRM_FORM_ENDPOINT} method="POST" id="black-friday-popup-form" data-crm-form data-form-id="black-friday-popup">
      <input type="hidden" name="redirect" value="https://www.nextvisionstudio.com/quotesend/?submitted=1&source=black-friday-popup" />
      <input type="hidden" name="subject" value="Black Friday popup enquiry" />
      <input type="hidden" name="form_type" value="Black Friday popup" />
      <input type="hidden" name="service" value="Black Friday popup - Full Monthly Content" />
      <input type="hidden" name="message" value="Black Friday popup lead: Full Monthly Content, regular EUR 550, Black Friday EUR 450/month, 8 short videos plus 8 edited on-location photographs. Offer valid until 30 November 2026. Production only; posting and account management are separate." />
      <input type="hidden" name="content_package" value="Full Monthly Content — Black Friday EUR 450" />
      <div hidden aria-hidden="true"><input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></div>
      <label for="bf-name">Name</label>
      <input id="bf-name" name="name" autocomplete="name" placeholder="Your name" required />
      <label for="bf-email">Email</label>
      <input id="bf-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
      <label for="bf-phone">Phone</label>
      <input id="bf-phone" name="phone" type="tel" autocomplete="tel" placeholder="Your phone number" required />
      <button type="submit">Claim the deal</button>
      <p class="bf-privacy">No obligation. We’ll use your details to reply. <a href="/privacy-policy/">Privacy policy</a></p>
      <p data-bf-status role="status" aria-live="polite"></p>
    </form>
  </dialog>
</>}
<script>
const dialog = document.querySelector<HTMLDialogElement>('#black-friday-deal');
const promotionExpired = new Date() >= new Date('2026-12-01T00:00:00Z');
if (promotionExpired) {
  document.querySelector<HTMLElement>('[data-bf-open]')?.setAttribute('hidden', '');
  dialog?.remove();
}
if (dialog && !promotionExpired) {
  const key = 'nvs-black-friday-dismissed-v2';
  let dismissed = false;
  try { dismissed = sessionStorage.getItem(key) === 'true'; } catch {}
  const remember = () => { dismissed = true; try { sessionStorage.setItem(key, 'true'); } catch {} };
  const open = () => { if (!dialog.open) { dialog.showModal(); remember(); } };
  const autoOpen = () => { if (!dismissed) window.setTimeout(() => { if (!dismissed && !dialog.open) open(); }, 1500); };
  document.querySelector('[data-bf-open]')?.addEventListener('click', open);
  dialog.querySelector('.bf-close')?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', remember);
  dialog.addEventListener('click', event => {
    if (event.target === dialog) {
      const rect = dialog.getBoundingClientRect();
      const mouse = event as MouseEvent;
      if (mouse.clientX < rect.left || mouse.clientX > rect.right || mouse.clientY < rect.top || mouse.clientY > rect.bottom) dialog.close();
    }
  });
  autoOpen();
  document.addEventListener('astro:page-load', autoOpen);
  // The local preview never sends a CRM lead.
  dialog.querySelector('form')?.addEventListener('submit', event => {
    if (['localhost', '127.0.0.1'].includes(location.hostname)) {
      event.preventDefault();
      event.stopImmediatePropagation();
      const status = dialog.querySelector('[data-bf-status]');
      if (status) status.textContent = 'Preview only — no details were sent.';
    }
  }, true);
}
</script>
<style>
.bf-launch[hidden] { display: none; }
.bf-launch {
  position: fixed; bottom: 22px; left: 18px; z-index: 80; min-height: 42px;
  border: 1px solid #f1df86; border-radius: 24px; padding: 10px 16px;
  background: #15130a; color: #f1df86; font: inherit; font-size: 13px; font-weight: 750; cursor: pointer;
}
.bf-dialog {
  box-sizing: border-box; position: fixed; width: min(460px, calc(100% - 28px)); max-height: calc(100dvh - 24px);
  overflow: auto; padding: 22px 30px 18px; border: 1px solid #f1df86; border-radius: 22px;
  background: #111; color: #f7f5ef; box-shadow: 0 24px 80px #0009;
}
.bf-dialog::backdrop { background: rgb(12 10 7 / 76%); }
.bf-close {
  position: absolute; top: 10px; right: 12px; width: 40px; height: 40px; border: 0; border-radius: 50%;
  background: #302d25; color: #f7f5ef; font: inherit; font-size: 26px; cursor: pointer;
}
.bf-label { margin: 0 0 7px; color: #f1df86; text-align: center; font-size: 11px; font-weight: 800; letter-spacing: .14em; }
h2 { margin: 0 auto 6px; max-width: 100%; text-align: center; font-size: clamp(24px, 5vw, 30px); line-height: 1.08; letter-spacing: -.035em; }
p { color: #d1cec4; font-size: 14px; line-height: 1.5; }
.bf-price-line { display: flex; align-items: center; justify-content: center; gap: 14px; margin: 0 0 12px; }
.bf-price-line del { color: #aaa69b; font-size: 20px; text-decoration-thickness: 2px; }
.bf-price-line span { display: inline-flex; align-items: baseline; gap: 7px; color: #f1df86; }
.bf-price-line small { font-size: 12px; font-weight: 850; letter-spacing: .12em; }
.bf-price-line strong { color: #f1df86; font-size: 38px; line-height: 1; }
.bf-price-line em { color: #d1cec4; font-size: 12px; font-style: normal; }
label { display: block; margin: 8px 0 4px; color: #f7f5ef; font-size: 12px; font-weight: 650; }
input:not([type=hidden]):not([type=checkbox]) {
  box-sizing: border-box; width: 100%; min-height: 40px; padding: 9px 12px; border: 1px solid #69675f;
  border-radius: 8px; background: #1a1a18; color: #fff; font: inherit; font-size: 14px;
}
input::placeholder { color: #aaa69b; }
button[type=submit] {
  width: 100%; min-height: 44px; margin-top: 12px; padding: 10px 14px; border: 0; border-radius: 9px;
  background: #f1df86; color: #15130a; font: inherit; font-size: 15px; font-weight: 800; cursor: pointer;
}
.bf-privacy { margin: 10px 0 0; color: #aaa69b; text-align: center; font-size: 11px; }
.bf-privacy a { color: #f1df86; text-underline-offset: 3px; }
button:focus-visible, input:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
@media (max-width: 520px) {
  .bf-dialog { padding: 20px 20px 16px; border-radius: 18px; }
  .bf-launch { bottom: 14px; left: 12px; }
}
</style>
