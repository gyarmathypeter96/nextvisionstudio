<BaseLayout title="Video Production Dublin | Short-Form & Business Video"
 description="Video production in Dublin for local businesses: Reels, TikToks and business videos planned, filmed and edited for you. Monthly packages from €350."
 canonical="https://www.nextvisionstudio.com/" minimal={true} visualTheme="orbit-home">
 {['style','refinements','space-layers','content-port','consolidated','production'].map(name => <link rel="stylesheet" href={`/orbit/${name}.css`} />)}
 {schemas.map(schema => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
 <Fragment set:html={prefix.split("__ORBIT_MONTHLY_PACKAGES__")[0]} />
 <div class="ported-packages section-pad"><MonthlyContentPackages compact={true} /></div>
 <Fragment set:html={prefix.split("__ORBIT_MONTHLY_PACKAGES__")[1]} />
 <div id="contact" class="orbit-production-contact"><ContactForm source="homepage-contact" /></div>
 <Fragment set:html={suffix} />
 <script is:inline src="/orbit/app.js"></script>
</BaseLayout>
<style is:global>
.minimal-site-logo{display:none!important}
#contact-form.contact{width:100%;max-width:none;margin:0;padding:80px var(--pad);border:0;border-radius:35px;background:var(--white);color:var(--black)}
#contact-form .contact__header h2{font-size:clamp(42px,6.6vw,94px);line-height:1.02;letter-spacing:-.05em;max-width:17ch;color:#111}
#contact-form .contact__header>p{display:none}
#contact-form .contact__header p,#contact-form .contact__field label,#contact-form .contact__field label span,#contact-form .contact__note,#contact-form .contact__step legend{color:#555}
#contact-form .contact__form{max-width:1000px;margin-left:0}
#contact-form :is(input:not([type=hidden]),select,textarea){background:#e9e8e3;color:#111;border-color:#9a9a96;color-scheme:light}
#contact-form .contact__button{background:#151515;color:#fff;border-color:#151515}
@media(max-width:760px){#contact-form.contact{padding:45px var(--pad)}#contact-form .contact__header h2{font-size:43px}}
</style>
