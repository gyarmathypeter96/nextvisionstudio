---
const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: "NextVision Studio Showreel | Video Production Dublin",
  description: "A selection of NextVision Studio video production work from Dublin and beyond.",
  thumbnailUrl: "https://www.nextvisionstudio.com/images/showreel/showreel-2025.webp",
  contentUrl: "https://www.nextvisionstudio.com/videos/showreel-2025.mp4",
  uploadDate: "2025-01-01",
};
---

<section class="showreel" id="showreel" aria-labelledby="showreel-title">
  <div class="showreel__inner">
    <div class="showreel__film">
      <video controls playsinline preload="metadata" poster="/images/showreel/showreel-2025.webp" aria-label="Play the NextVision Studio showreel">
        <source src="/videos/showreel-2025.mp4" type="video/mp4" />
        Your browser does not support HTML video.
      </video>
    </div>

    <div class="showreel__copy">
      <h2 id="showreel-title" class="sr-only">NextVision Studio showreel</h2>
      <p class="showreel__lead">
        From a clear plan to content that brings in enquiries.
      </p>
      <p class="showreel__body">
        We plan the message and audience, film your business in one focused shoot, then edit videos and photos for your website, social media and ads. Every piece is made to explain what you offer, build trust and help the right people take the next step.
      </p>
      <a href="#contact-form" data-cta-placement="showreel">Start a conversation <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />

<style>
  .showreel, .showreel * { box-sizing: border-box; }
  .showreel { padding: clamp(88px, 11vw, 164px) 24px; overflow: hidden; background: #050505; color: #fff; }
  .showreel__inner { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(280px, .75fr); align-items: center; gap: clamp(42px, 8vw, 126px); width: min(100%, 1260px); margin: 0 auto; }
  .showreel__film { position: relative; overflow: hidden; background: #000; box-shadow: 0 26px 72px rgba(0,0,0,.34); }
  .showreel video { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .showreel__copy { max-width: 500px; }
  .showreel__lead { margin: 0; color: #fff; font-size: clamp(29px, 3vw, 43px); font-weight: 400; line-height: 1.32; letter-spacing: -.045em; text-wrap: balance; }
  .showreel__body { margin: 28px 0 0; color: rgba(255, 255, 255, 0.82); font-size: clamp(18px, 1.55vw, 21px); font-weight: 400; line-height: 1.6; letter-spacing: -.01em; }
  .showreel__copy a { display: inline-flex; align-items: center; justify-content: center; gap: 16px; min-height: 58px; margin-top: clamp(34px, 5vw, 64px); padding: 13px 28px; border: 2px solid #fff; border-radius: 999px; color: #fff; font-size: 16px; font-weight: 700; letter-spacing: -.01em; text-decoration: none; transition: background-color .2s ease, color .2s ease; }
  .showreel__copy a:hover { background: #fff; color: #050505; }
  .showreel__copy a:focus-visible { outline: 2px solid #fff; outline-offset: 6px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 820px) {
    .showreel { padding: 74px 26px 88px; }
    .showreel__inner { grid-template-columns: 1fr; gap: 52px; }
    .showreel__copy { max-width: 580px; }
    .showreel__lead { font-size: clamp(27px, 8vw, 39px); }
    .showreel__body { font-size: 18px; }
  }
</style>
