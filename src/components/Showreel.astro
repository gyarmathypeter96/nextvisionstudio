---
const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: "NextVision Studio Showreel | Video Production Dublin",
  description: "A selection of NextVision Studio video production work from Dublin and beyond.",
  thumbnailUrl: "https://www.nextvisionstudio.com/images/showreel/showreel-2025.webp",
  contentUrl: "https://www.nextvisionstudio.com/videos/showreel-2025.mp4",
  uploadDate: "2025-01-01",
};
---

<section class="showreel" id="showreel" aria-labelledby="showreel-title">
  <div class="showreel__inner">
    <div class="showreel__film">
      <video controls playsinline preload="metadata" poster="/images/showreel/showreel-2025.webp" aria-label="Play the NextVision Studio showreel">
        <source src="/videos/showreel-2025.mp4" type="video/mp4" />
        Your browser does not support HTML video.
      </video>
    </div>

    <div class="showreel__copy">
      <p class="showreel__eyebrow">A quick look at the work</p>
      <h2 id="showreel-title">More formats.<br />One clear standard.</h2>
      <p>
        From one defining film to a full campaign of cutdowns, we bring the thinking,
        production and finish together—so your content is ready to earn attention everywhere it lands.
      </p>
      <a href="#contact-form" data-cta-placement="showreel">Start a conversation <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />

<style>
  .showreel, .showreel * { box-sizing: border-box; }
  .showreel { position: relative; padding: clamp(72px, 10vw, 144px) 24px; overflow: hidden; background: #111111; color: #fff; }
  .showreel::before { content: ""; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(circle at 15% 45%, rgba(154, 210, 255, .12), transparent 30%); }
  .showreel__inner { position: relative; display: grid; grid-template-columns: minmax(0, 1.38fr) minmax(280px, .62fr); align-items: center; gap: clamp(36px, 7vw, 112px); width: min(100%, 1240px); margin: 0 auto; }
  .showreel__film { position: relative; overflow: hidden; border: 1px solid rgba(255,255,255,.16); border-radius: 4px; background: #060606; box-shadow: 0 36px 100px rgba(0,0,0,.44); }
  .showreel__film::after { content: ""; position: absolute; inset: 0; border: 1px solid rgba(207,234,255,.13); pointer-events: none; }
  .showreel video { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .showreel__copy { max-width: 430px; }
  .showreel__eyebrow { margin: 0 0 22px; color: #cfeaff; font-size: 11px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .showreel h2 { margin: 0; font-size: clamp(42px, 5.5vw, 74px); font-weight: 800; line-height: .94; letter-spacing: -.065em; text-wrap: balance; }
  .showreel__copy > p:not(.showreel__eyebrow) { margin: 28px 0 0; color: rgba(255,255,255,.68); font-size: clamp(17px, 1.75vw, 21px); line-height: 1.5; text-wrap: balance; }
  .showreel__copy a { display: inline-flex; gap: 12px; align-items: center; margin-top: 34px; padding-bottom: 7px; border-bottom: 1px solid rgba(207,234,255,.7); color: #fff; font-size: 14px; font-weight: 800; letter-spacing: .06em; text-decoration: none; text-transform: uppercase; transition: color .2s ease, border-color .2s ease; }
  .showreel__copy a:hover { border-color: #fff; color: #cfeaff; }
  .showreel__copy a:focus-visible { outline: 2px solid #cfeaff; outline-offset: 6px; }
  @media (max-width: 820px) { .showreel { padding: 72px 18px 84px; } .showreel__inner { grid-template-columns: 1fr; gap: 42px; } .showreel__copy { max-width: 590px; } .showreel h2 { font-size: clamp(42px, 12vw, 64px); } }
</style>
