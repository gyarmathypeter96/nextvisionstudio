---
const stats = [
  {
    label: "Average cost per lead from managed campaigns",
    start: 100,
    target: 10,
    prefix: "€",
    formattedValue: "€10",
    suffix: "",
  },
  {
    label: "Video views across published client work",
    target: 1000000,
    prefix: "",
    formattedValue: "1,000,000+",
    suffix: "+",
  },
  {
    label: "Ad spend managed for client campaigns",
    target: 10000,
    prefix: "€",
    formattedValue: "€10,000+",
    suffix: "+",
  },
  {
    label: "Social media content published",
    target: 1000,
    prefix: "",
    formattedValue: "1,000+",
    suffix: "+",
  },
];
---

<section
  class="stats"
  id="results"
  aria-label="NextVision Studio results"
  data-stats
>
  <dl class="stats__grid">
    {
      stats.map((stat) => (
        <div class="stats__item">
          <dt>{stat.label}</dt>
          {
            stat.target ? (
              <dd
                class="stats__number"
                data-counter
                data-start={stat.start ?? 0}
                data-target={stat.target}
                data-prefix={stat.prefix}
                data-suffix={stat.suffix}
                aria-label={`${stat.formattedValue} ${stat.label.toLowerCase()}`}
              >
                {stat.formattedValue}
              </dd>
            ) : (
              <dd class="stats__number" aria-label={`${stat.formattedValue} ${stat.label.toLowerCase()}`}>
                {stat.formattedValue}
              </dd>
            )
          }
        </div>
      ))
    }
  </dl>
</section>

<script>
  const statsSection = document.querySelector("[data-stats]");

  if (statsSection) {
    const counters = statsSection.querySelectorAll("[data-counter]");
    const numberFormatter = new Intl.NumberFormat("en-US");
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const showFinalValues = () => {
      counters.forEach((counter) => {
        const target = Number(counter.getAttribute("data-target"));
        const prefix = counter.getAttribute("data-prefix") ?? "";
        const suffix = counter.getAttribute("data-suffix") ?? "";
        counter.textContent = `${prefix}${numberFormatter.format(target)}${suffix}`;
      });
    };

    const animateCounter = (counter: Element) => {
      if (counter.getAttribute("data-animated") === "true") return;

      counter.setAttribute("data-animated", "true");
      counter.classList.add("is-counting");

      const target = Number(counter.getAttribute("data-target"));
      const start = Number(counter.getAttribute("data-start") ?? 0);
      const prefix = counter.getAttribute("data-prefix") ?? "";
      const suffix = counter.getAttribute("data-suffix") ?? "";
      const duration = 1700;
      let startTime: number | undefined;

      const updateCounter = (currentTime: number) => {
        startTime ??= currentTime;

        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const easedProgress = 1 - Math.pow(1 - progress, 3);
        const currentValue = start > target
          ? Math.ceil(start - easedProgress * (start - target))
          : Math.floor(easedProgress * target);

        counter.textContent = `${prefix}${numberFormatter.format(currentValue)}${suffix}`;

        if (progress < 1) {
          window.requestAnimationFrame(updateCounter);
        } else {
          counter.textContent = `${prefix}${numberFormatter.format(target)}${suffix}`;
          counter.classList.remove("is-counting");
        }
      };

      window.requestAnimationFrame(updateCounter);
    };

    if (prefersReducedMotion || !("IntersectionObserver" in window)) {
      showFinalValues();
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;

          counters.forEach(animateCounter);
          observer.disconnect();
        },
        { threshold: 0.28 },
      );

      observer.observe(statsSection);
    }
  }
</script>

<style>
  .stats,
  .stats * {
    box-sizing: border-box;
  }

  .stats {
    width: 100%;
    margin: 0;
    padding: 52px 24px 62px;
    overflow: hidden;

    background: #111111;
    color: #ffffff;
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 34px;

    width: min(100%, 1180px);
    margin: 0 auto;
    padding: 0;
    text-align: center;
  }

  .stats__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    padding: 8px 0;
  }

  .stats__item dt {
    order: 2;
    margin: 16px 0 0;
    color: rgba(255, 255, 255, 0.58);

    font-size: clamp(14px, 1.4vw, 17px);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .stats__number {
    order: 1;
    margin: 0;
    color: #ffffff;

    font-size: clamp(48px, 5.6vw, 72px);
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .stats__number.is-counting {
    animation: counter-rise 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes counter-rise {
    from {
      opacity: 0.35;
      filter: blur(4px);
      transform: translateY(12px);
    }

    to {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0);
    }
  }

  @media (max-width: 767px) {
    .stats {
      padding: 42px 16px 50px;
    }

    .stats__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .stats__number {
      font-size: clamp(27px, 7.5vw, 32px);
      letter-spacing: 0;
    }

    .stats__item dt {
      margin-top: 10px;
      font-size: 12px;
    }
  }

  @media (max-width: 380px) {
    .stats__number {
      font-size: 27px;
      letter-spacing: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stats__number.is-counting {
      animation: none;
    }
  }
</style>
