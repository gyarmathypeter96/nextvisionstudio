---
// Coordinates use the United Nations Cartographic Section for capital cities,
// GeoNames for Győr and Alicante, and the UN geographic centre of Cyprus.
// The map uses an equirectangular Natural Earth 1:50m land outline.
const bounds = { west: -180, east: 180, north: 83.599609375, south: -89.99892578125002 };
const placeData = [
  { name: "Washington, DC", latitude: 38.819496155, longitude: -76.9131774226, key: "washington" },
  { name: "Dublin", latitude: 53.4353409243, longitude: -6.21339893837, key: "dublin" },
  { name: "Alicante", latitude: 38.34517, longitude: -0.48149, key: "alicante" },
  { name: "Győr", latitude: 47.6833322473, longitude: 17.6351165771, key: "gyor" },
  { name: "Budapest", latitude: 47.4518547032, longitude: 19.136859969, key: "budapest" },
  { name: "Cyprus", latitude: 35.126655, longitude: 33.425411, key: "cyprus" },
];

const locations = placeData.map((location) => ({
  ...location,
  x: ((location.longitude - bounds.west) / (bounds.east - bounds.west)) * 100,
  y: ((bounds.north - location.latitude) / (bounds.north - bounds.south)) * 100,
}));
---

<section id="locations" class="locations" aria-labelledby="locations-title">
  <header class="locations__header">
    <p>From Dublin, outward</p>
    <h2 id="locations-title">Places we work.<br />Stories we bring together.</h2>
  </header>

  <figure class="locations__map" aria-label="World map showing NextVision Studio production locations">
    <img src="/images/maps/world-countries.svg" width="1600" height="773" alt="" aria-hidden="true" loading="lazy" />
    <ul class="locations__pins" aria-label="Production locations">
      {locations.map((location) => (
        <li class={`locations__pin locations__pin--${location.key}`} style={`--x: ${location.x}%; --y: ${location.y}%;`}>
          <i aria-hidden="true"></i>
          <span>{location.name}</span>
        </li>
      ))}
    </ul>
  </figure>

  <ul class="locations__legend" aria-label="Production locations list">
    {locations.map((location) => <li>{location.name}</li>)}
  </ul>
</section>

<style>
  .locations, .locations * { box-sizing: border-box; }
  .locations { position: relative; padding: clamp(86px, 12vw, 154px) 24px clamp(80px, 11vw, 138px); overflow: hidden; background: #050505; color: #fff; }
  .locations::before { content: ""; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(circle at 48% 48%, rgba(24,132,255,.14), transparent 34%); }
  .locations__header { position: relative; z-index: 1; width: min(100%, 920px); margin: 0 auto clamp(38px, 5vw, 70px); text-align: center; }
  .locations__header p { margin: 0 0 20px; color: #178aff; font-size: 11px; font-weight: 850; letter-spacing: .16em; text-transform: uppercase; }
  .locations h2 { margin: 0; font-size: clamp(42px, 6vw, 82px); font-weight: 750; line-height: .94; letter-spacing: -.065em; text-wrap: balance; }
  .locations__map { position: relative; z-index: 1; width: min(100%, 1340px); margin: 0 auto; }
  .locations__map > img { display: block; width: 100%; height: auto; opacity: .96; filter: drop-shadow(0 24px 40px rgba(0,0,0,.4)); }
  .locations__pins { position: absolute; inset: 0; margin: 0; padding: 0; list-style: none; }
  .locations__pin { position: absolute; top: var(--y); left: var(--x); width: 0; height: 0; }
  .locations__pin i { position: absolute; z-index: 1; width: 15px; height: 15px; border: 4px solid #fff; border-radius: 50%; background: #178aff; box-shadow: 0 0 0 5px rgba(23,138,255,.22), 0 0 22px rgba(23,138,255,.9); transform: translate(-50%, -50%); }
  .locations__pin span { position: absolute; z-index: 2; color: #fff; font-size: 15px; font-weight: 750; line-height: 1; letter-spacing: -.02em; white-space: nowrap; text-shadow: 0 1px 8px #000; }
  .locations__pin--washington span { transform: translate(-111%, -18px); }
  .locations__pin--dublin span { transform: translate(-62%, -29px); }
  .locations__pin--alicante span { transform: translate(-88%, 19px); }
  .locations__pin--gyor span { transform: translate(18px, -31px); }
  .locations__pin--budapest span { transform: translate(20px, 12px); }
  .locations__pin--cyprus span { transform: translate(20px, 18px); }
  .locations__legend { display: none; }
  @media (max-width: 700px) {
    .locations { padding: 82px 17px; }
    .locations__map { width: 146%; margin-left: -23%; }
    .locations__pin span { display: none; }
    .locations__pin i { width: 11px; height: 11px; border-width: 3px; }
    .locations__legend { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 18px; width: min(100%, 460px); margin: 34px auto 0; padding: 0; list-style: none; color: rgba(255,255,255,.82); font-size: 14px; font-weight: 650; }
    .locations__legend li { display: flex; align-items: center; gap: 8px; }
    .locations__legend li::before { content: ""; width: 8px; height: 8px; flex: 0 0 auto; border: 2px solid #fff; border-radius: 50%; background: #178aff; box-shadow: 0 0 9px rgba(23,138,255,.8); }
  }
</style>
