---
const clients = [
  { name: "Gut Fest", src: "/images/clients/gut-fest.webp", width: 500, height: 500 },
  { name: "Saxoo London", src: "/images/clients/saxoo-london.webp", width: 500, height: 500 },
  { name: "Emo Night Brooklyn", src: "/images/clients/emo-night-brooklyn.webp", width: 500, height: 500 },
  { name: "Leroy's Barking World", src: "/images/clients/leroys-barking-world.webp", width: 500, height: 500 },
  { name: "Muri Pub and More", src: "/images/clients/muri-pub-and-more.webp", width: 500, height: 500 },
  { name: "The Macaron Boutique", src: "/images/clients/the-macaron-boutique.webp", width: 500, height: 500 },
  { name: "Japanese calligraphy client", src: "/images/clients/client-logo-07.webp", width: 500, height: 500 },
  { name: "Perfect Clean", src: "/images/clients/perfect-clean.webp", width: 517, height: 483 },
  { name: "Pogány Induló", src: "/images/clients/pogany-indulo.webp", width: 666, height: 375 },
];
---

<section class="clients" id="clients" aria-labelledby="clients-title">
  <h2 id="clients-title">Trusted by Dublin and worldwide brands</h2>
  <div class="clients__marquee" aria-label="Selected NextVision Studio clients">
    <div class="clients__track">
      {[...clients, ...clients].map((client, index) => (
        <div class="clients__item" aria-hidden={index >= clients.length ? "true" : undefined}>
          <img src={client.src} alt={index >= clients.length ? "" : `${client.name} logo`} width={client.width} height={client.height} loading={index < 5 ? "eager" : "lazy"} decoding="async" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .clients, .clients * { box-sizing: border-box; }
  .clients { position: relative; padding: 56px 0 66px; overflow: hidden; border-bottom: 1px solid rgba(255,255,255,.1); background: #111; color: #fff; }
  .clients h2 { width: min(100%, 980px); margin: 0 auto 42px; padding: 0 24px; color: rgba(255,255,255,.77); font-size: clamp(11px, 1.15vw, 14px); font-weight: 850; letter-spacing: .15em; line-height: 1.3; text-align: center; text-transform: uppercase; }
  .clients__marquee { width: 100%; overflow: hidden; mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent); }
  .clients__track { display: flex; width: max-content; align-items: center; animation: clients-marquee 48s linear infinite; }
  .clients__item { display: grid; flex: 0 0 clamp(145px, 13vw, 220px); height: 78px; padding: 0 26px; place-items: center; }
  .clients__item img { display: block; width: auto; max-width: 100%; height: auto; max-height: 54px; object-fit: contain; opacity: .68; filter: grayscale(1) saturate(0) brightness(1.3); transition: opacity .2s ease, filter .2s ease; }
  .clients__item:hover img { opacity: 1; filter: grayscale(0) brightness(1); }
  @keyframes clients-marquee { to { transform: translateX(-50%); } }
  @media (max-width: 640px) { .clients { padding: 44px 0 50px; } .clients h2 { margin-bottom: 31px; font-size: 10px; } .clients__item { flex-basis: 132px; height: 58px; padding: 0 20px; } .clients__item img { max-height: 40px; } .clients__track { animation-duration: 34s; } }
  @media (prefers-reduced-motion: reduce) { .clients__marquee { overflow-x: auto; mask-image: none; } .clients__track { animation: none; } }
</style>
