---

interface Props { title?: string; }
const { title = "Trusted by Irish businesses" } = Astro.props;
const clients = [{"name": "Perfect Clean", "src": "/images/clients/perfect-clean.webp", "href": "/case-studies/perfect-clean-video-advertising/", "width": 500, "height": 200}, {"name": "VentSolve", "src": "/images/clients/ventsolve.webp", "href": "/case-studies/ventsolve-content-production/", "width": 500, "height": 200}, {"name": "Amber Oxygen Therapy", "src": "/images/clients/amber-oxygen.svg", "href": "/case-studies/amber-oxygen-therapy-video-production/", "width": 500, "height": 200}, {"name": "Balbriggan Braces", "src": "/images/clients/balbriggan-braces.png", "href": "/case-studies/balbriggan-braces-dental-videos/", "width": 500, "height": 200}, {"name": "Gut Fest", "src": "/images/clients/gut-fest.webp", "href": "/case-studies/gut-fest-event-videography-dublin/", "width": 500, "height": 200}, {"name": "Leroy’s Barking World", "src": "/images/clients/leroys-barking-world.webp", "href": "/case-studies/leroys-barking-world-social-content/", "width": 500, "height": 200}, {"name": "Red Line Events", "src": "/images/clients/red-line-events.png", "href": "/case-studies/red-line-events-techno-video/", "width": 500, "height": 200}];
---

<section class="clients" id="clients" aria-labelledby="clients-title">
  <h2 id="clients-title">{title}</h2>
  <div class="clients__marquee" aria-label="Irish businesses NextVision Studio has worked with">
    <div class="clients__track" id="client-logos">
      {[...clients, ...clients].map((client, index) => (
        <div class="clients__item" aria-hidden={index >= clients.length ? "true" : undefined}>
          <a href={client.href ?? "/case-studies/"} tabindex={index >= clients.length ? -1 : undefined} aria-label={`View ${client.name} project${client.href ? "" : " portfolio"}`}><img src={client.src} alt={index >= clients.length ? "" : `${client.name} logo`} width={client.width} height={client.height} loading="eager" decoding="async" /></a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .clients, .clients * { box-sizing: border-box; }
  .clients { position: relative; padding: 56px 0 66px; overflow: hidden; border-bottom: 1px solid rgba(255,255,255,.1); background: #111; color: #fff; }
  .clients h2 { width: min(100%, 980px); margin: 0 auto 24px; padding: 0 24px; color: rgba(255,255,255,.77); font-size: clamp(23px, 3vw, 32px); font-weight: 600; line-height: 1.3; text-align: center; }
  .clients__marquee { width: 100%; overflow: hidden; mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent); }
  .clients__track { display: flex; width: max-content; align-items: center; animation: clients-marquee 48s linear infinite; }
  .clients__item { display: grid; flex: 0 0 clamp(145px, 13vw, 220px); height: 78px; padding: 0 26px; place-items: center; }
  .clients__item a { display: grid; place-items: center; width: 100%; height: 100%; border-radius: 6px; }
  .clients__item a:focus-visible { outline: 2px solid #cfeaff; outline-offset: 4px; }
  .clients__marquee:hover .clients__track, .clients__marquee:focus-within .clients__track { animation-play-state: paused; }
  .clients__item img { display: block; width: auto; max-width: 100%; height: auto; max-height: 54px; object-fit: contain; opacity: .68; filter: grayscale(1) saturate(0) brightness(1.3); transition: opacity .2s ease, filter .2s ease; }
  .clients__item img[src="/images/clients/red-line-events.png"] { background:#fff; border-radius:4px; opacity:1; filter:invert(1); }
  .clients__item:hover img { opacity: 1; filter: grayscale(0) brightness(1); }
  @keyframes clients-marquee { to { transform: translateX(-50%); } }
  @media (max-width: 640px) { .clients { padding: 44px 0 50px; } .clients h2 { margin-bottom: 31px; } .clients__item { flex-basis: 132px; height: 58px; padding: 0 20px; } .clients__item img { max-height: 40px; } .clients__track { animation-duration: 34s; } }
  @media (prefers-reduced-motion: reduce) {
    .clients__marquee { mask-image: none; }
    .clients__track { width: 100%; flex-wrap: wrap; justify-content: center; animation: none; }
    .clients__item[aria-hidden="true"] { display: none; }
  }
</style>
