---


const clients: { name: string; src: string; width: number; height: number; href?: string }[] = [
  { name: "Gut Fest", src: "/images/clients/gut-fest.webp", href: "/case-studies/gut-fest-event-videography-dublin/", width: 500, height: 500 },
  { name: "Saxoo London", src: "/images/clients/saxoo-london.png", href: "/case-studies/saxoo-london-fashion-video/", width: 280, height: 280 },
  { name: "Emo Night Brooklyn", src: "/images/clients/emo-night-brooklyn.webp", width: 500, height: 500 },
  { name: "Leroy's Barking World", src: "/images/clients/leroys-barking-world.webp", href: "/case-studies/leroys-barking-world-social-content/", width: 500, height: 500 },
  { name: "Muri Pub and More", src: "/images/clients/muri-pub-and-more.webp", href: "/case-studies/uri-muri-bar-video-photography/", width: 500, height: 500 },
  { name: "The Macaron Boutique", src: "/images/clients/the-macaron-boutique.webp", href: "/case-studies/macaron-boutique-product-video/", width: 500, height: 500 },
  { name: "Japanese calligraphy client", src: "/images/clients/client-logo-07.webp", width: 500, height: 500 },
  { name: "Perfect Clean", src: "/images/clients/perfect-clean.webp", href: "/case-studies/perfect-clean-video-advertising/", width: 517, height: 483 },
  { name: "Pogány Induló", src: "/images/clients/pogany-indulo.webp", href: "/case-studies/pogany-indulo-live-concert-video/", width: 666, height: 375 },
];
---

<section class="clients" id="clients" aria-labelledby="clients-title">
  <h2 id="clients-title">Some of the businesses I have worked with</h2>
  <ul class="clients__grid">
    {clients.map(client => <li><a href={client.href ?? "/case-studies/"} aria-label={`View ${client.name} project${client.href ? "" : " portfolio"}`}><img src={client.src} alt={`${client.name} logo`} width={client.width} height={client.height} loading="lazy" decoding="async" /></a></li>)}
  </ul>
</section>
<style>
.clients { padding:60px 24px; background:#111; color:#fff; }
.clients h2 { max-width:1180px; margin:0 auto 30px; font-size:clamp(23px,3vw,32px); line-height:1.3; font-weight:600; }
.clients__grid { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:20px; max-width:1180px; padding:0; margin:auto; list-style:none; }
.clients li { min-width:0; }
.clients a { display:grid; place-items:center; min-height:92px; border-radius:8px; }
.clients a:focus-visible { outline:2px solid #cfeaff; outline-offset:4px; }
.clients img { display:block; max-width:140px; width:100%; height:auto; max-height:62px; object-fit:contain; filter:grayscale(1); opacity:.8; }
.clients a:hover img { filter:none; opacity:1; }
@media(max-width:700px) { .clients__grid { grid-template-columns:repeat(3,minmax(0,1fr)); gap:15px; } .clients img { max-width:96px; max-height:48px; } }
@media(max-width:380px) { .clients__grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
</style>
